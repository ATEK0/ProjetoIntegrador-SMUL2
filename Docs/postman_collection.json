{
  "info": {
    "name": "MS-CAFIN API Tests",
    "description": "Coleção de testes para o microserviço financeiro MS-CAFIN.\n\nVariável {{base_url}} deve ser configurada no ambiente Postman (ex: http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Service is MS-CAFIN', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.service).to.eql('MS-CAFIN');",
                  "});",
                  "",
                  "pm.test('Status is online', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('online');",
                  "});",
                  "",
                  "pm.test('Version is present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.version).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Interest Simulation",
      "item": [
        {
          "name": "Simple Interest - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 10000,\n  \"rate\": 0.05,\n  \"time\": 3,\n  \"type\": \"simple\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/interest/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "interest", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Interest is 1500', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.interest).to.eql(1500.0);",
                  "});",
                  "",
                  "pm.test('Total amount is 11500', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total_amount).to.eql(11500.0);",
                  "});",
                  "",
                  "pm.test('Breakdown is null for basic calc', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.breakdown).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Compound Interest - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 10000,\n  \"rate\": 0.05,\n  \"time\": 3,\n  \"type\": \"compound\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/interest/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "interest", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Interest is approximately 1576.25', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.interest).to.be.within(1575, 1578);",
                  "});",
                  "",
                  "pm.test('Total amount present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total_amount).to.be.above(10000);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Interest with Rate Tiers - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 10000,\n  \"rate\": 0.03,\n  \"time\": 4,\n  \"type\": \"compound\",\n  \"rate_tiers\": [\n    {\"from_period\": 1, \"rate\": 0.03},\n    {\"from_period\": 3, \"rate\": 0.05}\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/interest/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "interest", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Breakdown is present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.breakdown).to.be.an('array');",
                  "    pm.expect(jsonData.breakdown.length).to.eql(4);",
                  "});",
                  "",
                  "pm.test('Rate tiers applied correctly', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.breakdown[0].rate).to.eql(0.03);",
                  "    pm.expect(jsonData.breakdown[2].rate).to.eql(0.05);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {

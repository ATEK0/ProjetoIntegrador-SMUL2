    {
      "name": "Amortization Simulation",
      "item": [
        {
          "name": "French Amortization - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 100000,\n  \"rate\": 0.05,\n  \"years\": 2,\n  \"periodicity\": \"monthly\",\n  \"commission\": 0.0,\n  \"type\": \"french\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/amortization/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "amortization", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Schedule is not empty', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.schedule).to.be.an('array');",
                  "    pm.expect(jsonData.schedule.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('TAEG is positive', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.taeg).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('IS inicial is present', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.is_inicial).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Final balance is zero', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var lastRow = jsonData.schedule[jsonData.schedule.length - 1];",
                  "    pm.expect(lastRow.balance).to.eql(0.0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "SAC Amortization - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 100000,\n  \"rate\": 0.05,\n  \"years\": 2,\n  \"periodicity\": \"monthly\",\n  \"commission\": 0.0,\n  \"type\": \"sac\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/amortization/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "amortization", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Schedule has 25 rows (24 months + period 0)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.schedule.length).to.eql(25);",
                  "});",
                  "",
                  "pm.test('Final balance is zero', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var lastRow = jsonData.schedule[jsonData.schedule.length - 1];",
                  "    pm.expect(lastRow.balance).to.eql(0.0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "American Amortization - Valid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 100000,\n  \"rate\": 0.05,\n  \"years\": 2,\n  \"periodicity\": \"monthly\",\n  \"commission\": 0.0,\n  \"type\": \"american\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/simulate/amortization/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "simulate", "amortization", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Only last period has amortization', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var schedule = jsonData.schedule;",
                  "    for (var i = 1; i < schedule.length - 1; i++) {",
                  "        pm.expect(schedule[i].amortization).to.eql(0.0);",
                  "    }",
                  "    pm.expect(schedule[schedule.length - 1].amortization).to.eql(100000);",
                  "});",
                  "",
                  "pm.test('Final balance is zero', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var lastRow = jsonData.schedule[jsonData.schedule.length - 1];",
                  "    pm.expect(lastRow.balance).to.eql(0.0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },

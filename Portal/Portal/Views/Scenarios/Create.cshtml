@model Portal.Models.Scenario

@{
    ViewData["Title"] = "Criar Cenário Familiar";
}

<div class="card glass-panel" style="max-width: 600px; margin: 2rem auto;">
    <h2 style="margin-bottom: var(--spacing-md); color: var(--primary-blue); display: flex; align-items: center; gap: var(--spacing-sm);">
        <i class="fas fa-plus-circle"></i> Definir Cenário Familiar Base
    </h2>
    <p class="text-muted" style="margin-bottom: var(--spacing-lg);">
        Configure a sua família virtual para iniciar as simulações financeiras e responder aos desafios.
    </p>

    <form asp-action="Create" method="post" class="flex flex-col gap-md">
        @if (ViewBag.ChallengeId != null)
        {
            <input type="hidden" name="challengeId" value="@ViewBag.ChallengeId" />
        }
        
        <div class="form-group">
            <label asp-for="FamilyName" class="form-label">Nome da Família</label>
            <input asp-for="FamilyName" class="form-control" placeholder="Ex: Família Silva" required />
            <span asp-validation-for="FamilyName" class="text-danger" style="font-size: 0.875rem; color: #ef4444; display: block; margin-top: var(--spacing-xs);"></span>
        </div>

        <div class="form-group">
            <label asp-for="InitialBalance" class="form-label">Saldo Inicial (€)</label>
            <input asp-for="InitialBalance" type="number" step="0.01" class="form-control" placeholder="0.00" required />
            <span asp-validation-for="InitialBalance" class="text-danger" style="font-size: 0.875rem; color: #ef4444; display: block; margin-top: var(--spacing-xs);"></span>
        </div>

        <div class="flex gap-md" style="margin-top: var(--spacing-md);">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
                <i class="fas fa-save" style="margin-right: 8px;"></i> Gravar Cenário
            </button>
            <a href="/Dashboard/Aluno" class="btn btn-outline" style="flex: 1;">
                Cancelar
            </a>
        </div>
    </form>
</div>
@model Portal.Models.ViewModels.SolveQuizViewModel

@{
    ViewData["Title"] = "Resolver Quiz";
}

<style>
    .quiz-container {
        max-width: 800px;
        margin: 0 auto;
        padding: var(--spacing-xl);
    }
    
    .quiz-header {
        text-align: center;
        margin-bottom: var(--spacing-xl);
        padding: var(--spacing-lg);
        background: var(--surface-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .question-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
    }

    .question-text {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--dark-grey);
        margin-bottom: var(--spacing-md);
        display: flex;
        gap: 12px;
    }

    .question-number {
        color: var(--primary-blue);
        font-weight: 800;
    }

    .option-label {
        display: block;
        padding: 16px;
        margin-bottom: 12px;
        background: rgba(255, 255, 255, 0.5);
        border: 2px solid var(--border-color);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: var(--transition);
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--text-main);
    }

    .option-label:hover {
        background: rgba(12, 115, 183, 0.05);
        border-color: rgba(12, 115, 183, 0.3);
    }

    .option-input {
        display: none;
    }

    .option-input:checked + .option-label {
        background: rgba(12, 115, 183, 0.1);
        border-color: var(--primary-blue);
        color: var(--primary-blue);
        font-weight: 600;
        box-shadow: inset 0 0 0 1px var(--primary-blue);
    }

    .floating-actions {
        position: sticky;
        bottom: var(--spacing-lg);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        padding: var(--spacing-md);
        border-radius: var(--radius-lg);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid rgba(12, 115, 183, 0.15);
        z-index: 100;
        margin-top: var(--spacing-xl);
    }

    /* Modal de Resultado */
    .result-modal {
        display: none;
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(8px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

    .result-modal.active {
        display: flex;
    }

    .result-card {
        background: var(--surface-color);
        padding: var(--spacing-xl);
        border-radius: var(--radius-lg);
        text-align: center;
        max-width: 400px;
        width: 100%;
        animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes scaleUp {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .score-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: var(--primary-blue);
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--spacing-lg) auto;
        box-shadow: 0 10px 20px rgba(12, 115, 183, 0.3);
    }
</style>

<div class="container animate-fade-in quiz-container">
    
    <div class="quiz-header">
        <div style="background-color: rgba(245, 158, 11, 0.1); width: 64px; height: 64px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #f59e0b; margin-bottom: var(--spacing-sm);">
            <i class="fas fa-question-circle fa-2x"></i>
        </div>
        <h1 style="color: var(--primary-blue); font-weight: 800; font-size: 2rem; margin-bottom: 8px;">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted" style="max-width: 500px; margin: 0 auto;">@Model.Description</p>
        }
    </div>

    <form id="solveQuizForm" onsubmit="submitAnswers(event)">
        <input type="hidden" id="challengeId" value="@Model.ChallengeId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="question-card" data-question-id="@q.QuestionId">
                <div class="question-text">
                    <span class="question-number">@(i + 1).</span>
                    @q.Text
                </div>
                
                <div class="options-container">
                    @foreach (var opt in q.Options)
                    {
                        <div class="option-item">
                            <input type="radio" name="question_@q.QuestionId" id="opt_@opt.OptionId" value="@opt.OptionId" class="option-input" required />
                            <label for="opt_@opt.OptionId" class="option-label">
                                @opt.Text
                            </label>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="floating-actions">
            <div>
                <a href="/Dashboard/Aluno" class="btn btn-outline" style="border: none;">Cancelar</a>
            </div>
            <div>
                <button type="submit" class="btn btn-primary" id="submitQuizBtn" style="padding: 10px 32px; font-weight: 700; font-size: 1.05rem; box-shadow: var(--shadow-md);">
                    Submeter Quiz <i class="fas fa-check-circle" style="margin-left: 8px;"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Modal de Resultados -->
<div class="result-modal" id="resultModal">
    <div class="result-card">
        <div class="score-circle">
            <div style="font-size: 2.5rem; font-weight: 800; line-height: 1;" id="scoreValue">0</div>
            <div style="font-size: 0.9rem; opacity: 0.9;">Pontos</div>
        </div>
        
        <h2 style="color: var(--dark-grey); margin-bottom: 8px;">Quiz Concluído!</h2>
        <p class="text-muted" style="margin-bottom: var(--spacing-lg);">O teu resultado foi gravado com sucesso.</p>
        
        <a href="/Dashboard/Aluno" class="btn btn-primary" style="width: 100%; padding: 12px; font-weight: 600;">Voltar ao Dashboard</a>
    </div>
</div>

<script>
    async function submitAnswers(e) {
        e.preventDefault();

        const challengeId = document.getElementById('challengeId').value;
        const form = document.getElementById('solveQuizForm');
        const questionsCards = document.querySelectorAll('.question-card');
        
        const answers = [];
        let allAnswered = true;

        questionsCards.forEach(card => {
            const qId = card.getAttribute('data-question-id');
            const selectedOpt = form.elements[`question_${qId}`].value;
            
            if (!selectedOpt) {
                allAnswered = false;
            } else {
                answers.push({
                    QuestionId: parseInt(qId),
                    SelectedOptionId: parseInt(selectedOpt)
                });
            }
        });

        if (!allAnswered) {
            alert('Por favor, responda a todas as perguntas antes de submeter.');
            return;
        }

        const payload = {
            ChallengeId: parseInt(challengeId),
            Answers: answers
        };

        const btn = document.getElementById('submitQuizBtn');
        const ogText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A avaliar...';
        btn.disabled = true;

        try {
            const response = await fetch('/Challenges/SubmitQuiz', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            
            if (response.ok && data.success) {
                document.getElementById('scoreValue').textContent = data.score;
                document.getElementById('resultModal').classList.add('active');
            } else {
                alert(data.message || 'Ocorreu um erro ao submeter o quiz.');
                btn.innerHTML = ogText;
                btn.disabled = false;
            }
        } catch(error) {
            alert('Erro de comunicação com o servidor.');
            btn.innerHTML = ogText;
            btn.disabled = false;
        }
    }
</script>

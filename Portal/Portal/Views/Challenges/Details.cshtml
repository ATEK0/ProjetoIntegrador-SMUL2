@model Portal.Models.ViewModels.ChallengeDetailsViewModel

@{
    ViewData["Title"] = "Detalhes de Desafio";
}

<style>
    .info-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
        height: 100%;
    }
    
    .info-card h4 {
        margin-top: 0;
        margin-bottom: var(--spacing-md);
        color: var(--primary-blue);
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: var(--spacing-sm);
    }
    
    .list-item {
        padding: var(--spacing-sm) 0;
        border-bottom: 1px dashed var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .list-item:last-child {
        border-bottom: none;
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-md) 0 var(--spacing-xl) 0;">

    <div style="margin-bottom: var(--spacing-lg);">
        <a href="/Dashboard/AdminChallenges" class="text-muted" style="text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fas fa-arrow-left"></i> Voltar aos Desafios
        </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: var(--spacing-lg);">
        
        <!-- Edição do Desafio -->
        <div class="info-card">
            <h4><i class="fas fa-edit"></i> Dados do Desafio</h4>
            <form action="/Challenges/Edit" method="post">
                <input type="hidden" name="id" value="@Model.Challenge.Id" />
                
                <div class="form-group" style="margin-bottom: var(--spacing-md);">
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Título</label>
                    <input type="text" name="title" class="form-control" value="@Model.Challenge.Title" required />
                </div>
                
                <div class="form-group" style="margin-bottom: var(--spacing-md);">
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Descrição</label>
                    <textarea name="description" class="form-control" rows="3">@Model.Challenge.Description</textarea>
                </div>
                
                <div style="margin-bottom: var(--spacing-md); display: flex; align-items: center; justify-content: space-between; background: rgba(16, 185, 129, 0.05); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px dashed rgba(16, 185, 129, 0.2);">
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Código de Acesso</span>
                    <span style="font-family: 'Courier New', Courier, monospace; font-size: 1.2rem; font-weight: 700; color: #10b981; letter-spacing: 1px;">@Model.Challenge.AccessLinkCode</span>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Guardar Alterações</button>
            </form>

            <h4 style="margin-top: var(--spacing-xl); border-top: 1px solid var(--border-color); padding-top: var(--spacing-md);"><i class="fas fa-link"></i> Associação a Turma</h4>
            <form action="/Challenges/AssociateClass" method="post" style="margin: 0;">
                <input type="hidden" name="challengeId" value="@Model.Challenge.Id" />
                <input type="hidden" name="returnUrl" value="/Challenges/Details/@Model.Challenge.Id" />
                <div style="display: flex; gap: var(--spacing-sm);">
                    <div style="flex: 1;">
                        <select name="classId" class="form-control" style="width: 100%;">
                            @if (Model.Challenge.ClassId == null)
                            {
                                <option value="" selected>Independente (Por Código)</option>
                            }
                            else
                            {
                                <option value="">Independente (Por Código)</option>
                            }
                            
                            @foreach (var cls in Model.AvailableClasses)
                            {
                                if (Model.Challenge.ClassId == cls.Id)
                                {
                                    <option value="@cls.Id" selected>@cls.Name</option>
                                }
                                else
                                {
                                    <option value="@cls.Id">@cls.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline">Associar</button>
                </div>
            </form>
        </div>
        
        <!-- Participantes e Zonas de Perigo -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <div class="info-card">
                <h4><i class="fas fa-users"></i> Alunos Participantes</h4>
                @if (Model.Scenarios.Any())
                {
                    <div style="display: flex; flex-direction: column; max-height: 300px; overflow-y: auto;">
                        @foreach (var s in Model.Scenarios)
                        {
                            <div class="list-item">
                                <div>
                                    <span style="font-weight: 600; color: var(--dark-grey);">@s.Student?.Name</span>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">Família: @s.FamilyName</div>
                                </div>
                                <div style="font-size: 0.85rem; font-weight: bold; color: var(--primary-blue);">
                                    @s.InitialBalance.ToString("C")
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-style: italic; font-size: 0.9rem;">Ainda nenhum aluno iniciou este desafio.</p>
                }
            </div>

            <div class="info-card" style="border-color: rgba(239, 68, 68, 0.3); background-color: rgba(239, 68, 68, 0.02);">
                <h4 style="color: #ef4444; border-color: rgba(239, 68, 68, 0.2);"><i class="fas fa-exclamation-triangle"></i> Zona de Perigo</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: var(--spacing-md);">A eliminação de um desafio é irreversível. Todos os cenários, registos e pontuações associadas a este desafio poderão ser afetados.</p>
                
                <form asp-controller="Challenges" asp-action="Delete" method="post" onsubmit="return confirm('ATENÇÃO: Tem a certeza absoluta que deseja eliminar este desafio permanentemente?');">
                    <input type="hidden" name="id" value="@Model.Challenge.Id" />
                    <button type="submit" class="btn btn-outline" style="width: 100%; color: #ef4444; border-color: rgba(239, 68, 68, 0.3); background-color: white;">
                        <i class="fas fa-trash-alt"></i> Eliminar Desafio
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>

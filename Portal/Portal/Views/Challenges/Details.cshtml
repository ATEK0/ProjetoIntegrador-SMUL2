@model Portal.Models.ViewModels.ChallengeDetailsViewModel

@{
    ViewData["Title"] = "Detalhes de Desafio";
}

<style>
    .btn-danger-outline {
        border-color: #ef4444 !important;
        color: #ef4444 !important;
    }
    .btn-danger-outline:hover {
        background-color: #ef4444 !important;
        color: white !important;
    }

    .info-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
        height: 100%;
    }
    
    .info-card h4 {
        margin-top: 0;
        margin-bottom: var(--spacing-md);
        color: var(--primary-blue);
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: var(--spacing-sm);
    }
    
    .list-item {
        padding: var(--spacing-sm) 0;
        border-bottom: 1px dashed var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .list-item:last-child {
        border-bottom: none;
    }

    .question-row-card {
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        margin-bottom: var(--spacing-sm);
        position: relative;
    }

    .question-row-card:hover {
        background: rgba(12, 115, 183, 0.01);
        border-color: rgba(12, 115, 183, 0.2);
    }

    .badge-type {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
        display: inline-block;
        margin-top: 4px;
    }

    .badge-simple { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .badge-mc { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .badge-tf { background: rgba(16, 185, 129, 0.1); color: #10b981; }

    /* Student Status Badges */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-notstarted { background: rgba(107, 114, 128, 0.1); color: #6b7280; }
    .status-submitted { background: rgba(245, 158, 11, 0.1); color: #d97706; }
    .status-graded { background: rgba(16, 185, 129, 0.1); color: #10b981; }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-md) 0 var(--spacing-xl) 0;">





    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); align-items: start;">
        
        <!-- Coluna Esquerda: Dados do Desafio -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            @if (User.IsInRole("Admin") || User.IsInRole("Professor"))
            {
                <div class="info-card">
                    <h3 style="color: var(--primary-blue); font-size: 1.1rem; margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-top: 0;">
                        Configurações do Desafio
                    </h3>

                    <div style="margin-bottom: var(--spacing-lg);">
                        <label style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Código de Acesso</label>
                        <div>
                            <span style="font-family: 'Courier New', Courier, monospace; font-size: 1.25rem; font-weight: 700; letter-spacing: 2px; background: rgba(12, 115, 183, 0.08); color: var(--primary-blue); padding: 8px 16px; border-radius: var(--radius-md); border: 1px dashed rgba(12, 115, 183, 0.3); display: inline-block; margin-top: 8px;">
                                @Model.Challenge.AccessLinkCode
                            </span>
                        </div>
                    </div>
                    
                    <form action="/Challenges/Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Challenge.Id" />

                        <div class="form-group" style="margin-bottom: var(--spacing-md);">
                            <label style="font-weight: 600; color: var(--dark-grey); margin-bottom: var(--spacing-xs); display: block; font-size: 0.9rem;">Título</label>
                            <input type="text" name="title" class="form-control" value="@Model.Challenge.Title" required />
                        </div>
                        
                        <div class="form-group" style="margin-bottom: var(--spacing-md);">
                            <label style="font-weight: 600; color: var(--dark-grey); margin-bottom: var(--spacing-xs); display: block; font-size: 0.9rem;">Descrição</label>
                            <textarea name="description" class="form-control" rows="4">@Model.Challenge.Description</textarea>
                        </div>

                        <h4 style="margin-top: var(--spacing-md); border-top: 1px solid var(--border-color); padding-top: var(--spacing-md); margin-bottom: var(--spacing-sm); color: var(--primary-blue); font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
                            <i class="fas fa-link"></i> Associação a Turma
                        </h4>
                        <div class="form-group" style="margin-bottom: var(--spacing-lg);">
                            <select name="classId" class="form-control" style="font-weight: 600; color: var(--dark-grey);">
                                <option value="">-- Independente (Acesso por Código) --</option>
                                @if (Model.AvailableClasses != null)
                                {
                                    foreach (var c in Model.AvailableClasses)
                                    {
                                        if (Model.Challenge.ClassId == c.Id)
                                        {
                                            <option value="@c.Id" selected>@c.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Guardar Alterações</button>
                    </form>
                </div>

                <div class="info-card danger-zone" style="border: 1px dashed #ef4444; background: rgba(239, 68, 68, 0.02);">
                    <h3 style="color: #ef4444; font-size: 1.05rem; margin-bottom: var(--spacing-sm); margin-top: 0;">Eliminar Desafio</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: var(--spacing-md);">Esta ação é irreversível. Todos os cenários, registos, entregas e pontuações associadas a este desafio serão eliminados permanentemente.</p>
                    
                    <button type="button" class="btn btn-outline btn-danger-outline" style="width: 100%; background-color: white;" onclick="document.getElementById('deleteChallengeModal').classList.add('active');">
                        Eliminar Desafio
                    </button>
                </div>
            }
            else
            {
                <div class="info-card">
                    <h4 style="margin: 0; border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm); margin-bottom: var(--spacing-md); color: var(--primary-blue); font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-trophy"></i> Dados do Desafio
                    </h4>
                    
                    <div class="form-group" style="margin-bottom: var(--spacing-md);">
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Título</label>
                        <div style="font-size: 1.05rem; font-weight: 600; color: var(--dark-grey); padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md);">@Model.Challenge.Title</div>
                    </div>
                    
                    <div class="form-group" style="margin-bottom: var(--spacing-md);">
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Descrição</label>
                        <div style="font-size: 0.95rem; color: var(--dark-grey); padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); min-height: 80px;">@(string.IsNullOrWhiteSpace(Model.Challenge.Description) ? "Sem descrição." : Model.Challenge.Description)</div>
                    </div>
                    
                    <div style="margin-bottom: var(--spacing-md); display: flex; align-items: center; justify-content: space-between; background: rgba(16, 185, 129, 0.05); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px dashed rgba(16, 185, 129, 0.2);">
                        <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Código de Acesso</span>
                        <span style="font-family: 'Courier New', Courier, monospace; font-size: 1.2rem; font-weight: 700; color: #10b981; letter-spacing: 1px;">@Model.Challenge.AccessLinkCode</span>
                    </div>

                    <h4 style="margin-top: var(--spacing-xl); border-top: 1px solid var(--border-color); padding-top: var(--spacing-md); margin-bottom: var(--spacing-md); color: var(--primary-blue); font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-link"></i> Associação a Turma
                    </h4>
                    <div style="padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.95rem; color: var(--dark-grey);">
                        <i class="fas fa-graduation-cap" style="margin-right: 6px; color: var(--text-muted);"></i>
                        @(Model.Challenge.Class != null ? Model.Challenge.Class.Name : "Independente (Por Código)")
                    </div>
                </div>
            }

        </div>

        <!-- Coluna Direita: Perguntas do Desafio e Alunos Inscritos -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <!-- Perguntas do Desafio -->
            <div class="info-card">
                <h4><i class="fas fa-question-circle"></i> Perguntas do Desafio</h4>

                @if (Model.Questions.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); max-height: 400px; overflow-y: auto; padding-right: 4px;">
                        @foreach (var q in Model.Questions)
                        {
                            <div class="question-row-card" style="margin-bottom: 8px;">
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <strong style="font-size: 0.95rem; color: var(--dark-grey);">@q.QuestionText</strong>
                                    <div>
                                        @if (q.QuestionType == Portal.Models.QuestionType.Simple)
                                        {
                                            <span class="badge-type badge-simple">Pergunta Simples</span>
                                        }
                                        else if (q.QuestionType == Portal.Models.QuestionType.MultipleChoice)
                                        {
                                            <span class="badge-type badge-mc">Escolha Múltipla</span>
                                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px;">
                                                <div>A: @q.OptionA</div>
                                                <div>B: @q.OptionB</div>
                                                <div>C: @q.OptionC</div>
                                                <div>D: @q.OptionD</div>
                                            </div>
                                            <div style="font-size: 0.8rem; font-weight: 700; color: #10b981; margin-top: 4px;">
                                                Correta: @q.CorrectAnswer
                                            </div>
                                        }
                                        else if (q.QuestionType == Portal.Models.QuestionType.TrueFalse)
                                        {
                                            <span class="badge-type badge-tf">Verd/Falso</span>
                                            <div style="font-size: 0.8rem; font-weight: 700; color: #10b981; margin-top: 4px;">
                                                Correta: @(q.CorrectAnswer == "true" ? "Verdadeiro" : "Falso")
                                            </div>
                                        }
                                        else if (q.QuestionType == Portal.Models.QuestionType.Scenario)
                                        {
                                            <span class="badge-type badge-simple" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">Cenário</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; color: var(--text-muted); padding: 30px 0; font-size: 0.9rem;">
                        <div style="margin-bottom: var(--spacing-sm); color: var(--text-muted);"><i class="fas fa-info-circle fa-2x"></i></div>
                        Este desafio ainda não tem perguntas configuradas.
                    </div>
                }
            </div>

            <!-- Alunos Participantes e Estado de Entregas -->
            <div class="info-card">
                <h4><i class="fas fa-users"></i> Alunos e Estado de Entrega</h4>
                
                @if (Model.StudentStatuses.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); max-height: 400px; overflow-y: auto;">
                        @foreach (var s in Model.StudentStatuses)
                        {
                            <div class="list-item" style="padding: 10px 0;">
                                <div style="flex: 1;">
                                    <span style="font-weight: 700; color: var(--dark-grey);">@s.StudentName</span>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">@s.StudentEmail</div>
                                </div>
                                <div style="display: flex; align-items: center; gap: var(--spacing-md);">
                                    @if (!s.IsSubmitted)
                                    {
                                        <span class="status-badge status-notstarted"><i class="fas fa-minus-circle"></i> Não Iniciado</span>
                                    }
                                    else if (!s.IsGraded)
                                    {
                                        <span class="status-badge status-submitted" style="margin-right: 8px;"><i class="fas fa-clock"></i> Por Avaliar</span>
                                        @if (User.IsInRole("Professor"))
                                        {
                                            <a href="/Challenges/GradeSubmission/@s.SubmissionId" class="btn btn-primary" style="padding: 4px 10px; font-size: 0.775rem; font-weight: 600; border-radius: var(--radius-sm); height: auto; line-height: 1;">
                                                Avaliar
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="status-badge status-graded" style="margin-right: 8px;"><i class="fas fa-check-circle"></i> Avaliado</span>
                                        @if (User.IsInRole("Professor"))
                                        {
                                            <a href="/Challenges/GradeSubmission/@s.SubmissionId" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.775rem; font-weight: 600; border-radius: var(--radius-sm); height: auto; line-height: 1; border-color: var(--primary-blue); color: var(--primary-blue);">
                                                Reavaliar
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-style: italic; font-size: 0.9rem;">
                        @(Model.Challenge.ClassId == null ? "O desafio não possui alunos vinculados." : "Não existem alunos inscritos nesta turma.")
                    </p>
                }
            </div>

        </div>

    </div>
</div>

<!-- Delete Challenge Modal -->
<div id="deleteChallengeModal" class="modal-overlay">
    <div class="modal-card" style="max-width: 400px; text-align: center;">
        <button type="button" class="modal-close-btn" onclick="this.closest('.modal-overlay').classList.remove('active')"><i class="fas fa-times"></i></button>
        <div style="font-size: 3rem; color: #ef4444; margin-bottom: 16px;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 style="color: var(--primary-blue); font-size: 1.35rem; font-weight: 700; margin-bottom: 8px;">Eliminar Desafio</h3>
        <p class="text-muted" style="margin-bottom: 24px; font-size: 0.9rem;">Tem a certeza absoluta que deseja eliminar este desafio permanentemente? Todos os cenários, registos, entregas e pontuações associadas a este desafio serão eliminados.</p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-sm);">
            <button type="button" class="btn btn-outline" onclick="this.closest('.modal-overlay').classList.remove('active')">Cancelar</button>
            <form action="/Challenges/Delete" method="post" style="margin: 0;">
                <input type="hidden" name="id" value="@Model.Challenge.Id" />
                <button type="submit" class="btn btn-primary" style="width: 100%; background-color: #ef4444; border-color: #ef4444;">Sim, Eliminar</button>
            </form>
        </div>
    </div>
</div>

@model Portal.Models.ViewModels.ChallengeDetailsViewModel

@{
    ViewData["Title"] = "Detalhes de Desafio";
}

<style>
    .info-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
        height: 100%;
    }
    
    .info-card h4 {
        margin-top: 0;
        margin-bottom: var(--spacing-md);
        color: var(--primary-blue);
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: var(--spacing-sm);
    }
    
    .list-item {
        padding: var(--spacing-sm) 0;
        border-bottom: 1px dashed var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .list-item:last-child {
        border-bottom: none;
    }

    .question-row-card {
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        margin-bottom: var(--spacing-sm);
        position: relative;
    }

    .question-row-card:hover {
        background: rgba(12, 115, 183, 0.01);
        border-color: rgba(12, 115, 183, 0.2);
    }

    .badge-type {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
        display: inline-block;
        margin-top: 4px;
    }

    .badge-simple { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .badge-mc { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .badge-tf { background: rgba(16, 185, 129, 0.1); color: #10b981; }

    /* Student Status Badges */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-notstarted { background: rgba(107, 114, 128, 0.1); color: #6b7280; }
    .status-submitted { background: rgba(245, 158, 11, 0.1); color: #d97706; }
    .status-graded { background: rgba(16, 185, 129, 0.1); color: #10b981; }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-md) 0 var(--spacing-xl) 0;">

    <div style="margin-bottom: var(--spacing-lg); display: flex; justify-content: space-between; align-items: center;">
        <a href="/Dashboard/AdminChallenges" class="text-muted" style="text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fas fa-arrow-left"></i> Voltar à Administração
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #065f46; font-size: 0.9rem;">
            <i class="fas fa-check-circle" style="margin-right: 6px;"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash error" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #991b1b; font-size: 0.9rem;">
            <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> @TempData["Error"]
        </div>
    }

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); align-items: start;">
        
        <!-- Coluna Esquerda: Dados do Desafio -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <div class="info-card">
                <h4><i class="fas fa-trophy"></i> Dados do Desafio</h4>
                
                <div class="form-group" style="margin-bottom: var(--spacing-md);">
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Título</label>
                    <div style="font-size: 1.05rem; font-weight: 600; color: var(--dark-grey); padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md);">@Model.Challenge.Title</div>
                </div>
                
                <div class="form-group" style="margin-bottom: var(--spacing-md);">
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Descrição</label>
                    <div style="font-size: 0.95rem; color: var(--dark-grey); padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); min-height: 80px;">@(string.IsNullOrWhiteSpace(Model.Challenge.Description) ? "Sem descrição." : Model.Challenge.Description)</div>
                </div>
                
                <div style="margin-bottom: var(--spacing-md); display: flex; align-items: center; justify-content: space-between; background: rgba(16, 185, 129, 0.05); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px dashed rgba(16, 185, 129, 0.2);">
                    <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Código de Acesso</span>
                    <span style="font-family: 'Courier New', Courier, monospace; font-size: 1.2rem; font-weight: 700; color: #10b981; letter-spacing: 1px;">@Model.Challenge.AccessLinkCode</span>
                </div>

                <h4 style="margin-top: var(--spacing-xl); border-top: 1px solid var(--border-color); padding-top: var(--spacing-md);"><i class="fas fa-link"></i> Associação a Turma</h4>
                <div style="padding: 10px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.95rem; color: var(--dark-grey);">
                    <i class="fas fa-graduation-cap" style="margin-right: 6px; color: var(--text-muted);"></i>
                    @(Model.Challenge.Class != null ? Model.Challenge.Class.Name : "Independente (Por Código)")
                </div>
            </div>

            <!-- Perigo -->
            <div class="info-card" style="border-color: rgba(239, 68, 68, 0.3); background-color: rgba(239, 68, 68, 0.02);">
                <h4 style="color: #ef4444; border-color: rgba(239, 68, 68, 0.2);"><i class="fas fa-exclamation-triangle"></i> Zona de Perigo</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: var(--spacing-md);">A eliminação de um desafio é irreversível. Todos os cenários, registos, entregas e pontuações associadas a este desafio serão eliminados permanentemente.</p>
                
                <form asp-controller="Challenges" asp-action="Delete" method="post" onsubmit="return confirm('ATENÇÃO: Tem a certeza absoluta que deseja eliminar este desafio permanentemente?');">
                    <input type="hidden" name="id" value="@Model.Challenge.Id" />
                    <button type="submit" class="btn btn-outline" style="width: 100%; color: #ef4444; border-color: rgba(239, 68, 68, 0.3); background-color: white;">
                        <i class="fas fa-trash-alt"></i> Eliminar Desafio
                    </button>
                </form>
            </div>

        </div>

        <!-- Coluna Direita: Perguntas do Desafio e Alunos Inscritos -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <!-- Perguntas do Desafio -->
            <div class="info-card">
                <h4><i class="fas fa-question-circle"></i> Perguntas do Desafio</h4>

                @if (Model.Questions.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); max-height: 400px; overflow-y: auto; padding-right: 4px;">
                        @foreach (var q in Model.Questions)
                        {
                            <div class="question-row-card" style="margin-bottom: 8px;">
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <strong style="font-size: 0.95rem; color: var(--dark-grey);">@q.QuestionText</strong>
                                    <div>
                                        @if (q.QuestionType == Portal.Models.QuestionType.Simple)
                                        {
                                            <span class="badge-type badge-simple">Pergunta Simples</span>
                                        }
                                        else if (q.QuestionType == Portal.Models.QuestionType.MultipleChoice)
                                        {
                                            <span class="badge-type badge-mc">Escolha Múltipla</span>
                                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px;">
                                                <div>A: @q.OptionA</div>
                                                <div>B: @q.OptionB</div>
                                                <div>C: @q.OptionC</div>
                                                <div>D: @q.OptionD</div>
                                            </div>
                                            <div style="font-size: 0.8rem; font-weight: 700; color: #10b981; margin-top: 4px;">
                                                Correta: @q.CorrectAnswer
                                            </div>
                                        }
                                        else if (q.QuestionType == Portal.Models.QuestionType.TrueFalse)
                                        {
                                            <span class="badge-type badge-tf">Verd/Falso</span>
                                            <div style="font-size: 0.8rem; font-weight: 700; color: #10b981; margin-top: 4px;">
                                                Correta: @(q.CorrectAnswer == "true" ? "Verdadeiro" : "Falso")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; color: var(--text-muted); padding: 30px 0; font-size: 0.9rem;">
                        <div style="margin-bottom: var(--spacing-sm); color: var(--text-muted);"><i class="fas fa-info-circle fa-2x"></i></div>
                        Este desafio ainda não tem perguntas configuradas.
                    </div>
                }
            </div>

            <!-- Alunos Participantes e Estado de Entregas -->
            <div class="info-card">
                <h4><i class="fas fa-users"></i> Alunos e Estado de Entrega</h4>
                
                @if (Model.StudentStatuses.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); max-height: 400px; overflow-y: auto;">
                        @foreach (var s in Model.StudentStatuses)
                        {
                            <div class="list-item" style="padding: 10px 0;">
                                <div style="flex: 1;">
                                    <span style="font-weight: 700; color: var(--dark-grey);">@s.StudentName</span>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">@s.StudentEmail</div>
                                </div>
                                <div style="display: flex; align-items: center; gap: var(--spacing-md);">
                                    @if (!s.IsSubmitted)
                                    {
                                        <span class="status-badge status-notstarted"><i class="fas fa-minus-circle"></i> Não Iniciado</span>
                                    }
                                    else if (s.IsSubmitted && !s.IsGraded)
                                    {
                                        <span class="status-badge status-submitted"><i class="fas fa-clock"></i> Por Avaliar</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-graded"><i class="fas fa-check-circle"></i> Avaliado</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted" style="font-style: italic; font-size: 0.9rem;">
                        @(Model.Challenge.ClassId == null ? "O desafio não possui alunos vinculados." : "Não existem alunos inscritos nesta turma.")
                    </p>
                }
            </div>

        </div>

    </div>
</div>

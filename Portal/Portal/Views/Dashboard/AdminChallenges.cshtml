@model Portal.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Gestão de Desafios - Administração";
}

<style>
    .admin-tabs {
        display: flex;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: var(--spacing-xl);
        gap: var(--spacing-md);
    }

    .tab-btn {
        background: transparent;
        border: none;
        padding: var(--spacing-md) var(--spacing-lg);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        cursor: pointer;
        transition: var(--transition);
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .tab-btn:hover {
        color: var(--primary-blue);
    }

    .tab-btn.active {
        color: var(--primary-blue);
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--primary-blue);
    }

    .table-row-hover:hover {
        background-color: rgba(12, 115, 183, 0.02);
    }

    .badge-status {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-block;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        padding: var(--spacing-md);
    }

    .modal-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .modal-card {
        background: var(--surface-color);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: var(--shadow-lg);
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        overflow-y: auto;
        padding: var(--spacing-xl);
        position: relative;
        transform: scale(0.95) translateY(15px);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-overlay.active .modal-card {
        transform: scale(1) translateY(0);
    }

    .modal-close-btn {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        background: transparent;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        color: var(--text-muted);
        transition: var(--transition);
        width: 32px;
        height: 32px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        background-color: rgba(0, 0, 0, 0.05);
        color: var(--text-main);
    }

    .input-icon-group {
        position: relative;
    }

    .input-icon-group i {
        position: absolute;
        left: var(--spacing-md);
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        transition: var(--transition);
        font-size: 1.1rem;
    }

    .input-icon-group .form-control {
        padding-left: 2.75rem;
        font-size: 1.05rem;
        height: 50px;
    }

    .input-icon-group .form-control:focus + i {
        color: var(--primary-blue);
    }

    .premium-label {
        font-weight: 600;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-xs);
        font-size: 0.95rem;
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-md) 0 var(--spacing-xl) 0;">



    <div>
        <div class="flex justify-between items-center" style="margin-bottom: var(--spacing-lg);">
            <div>
                <h3 style="color: var(--primary-blue); margin-bottom: 4px; font-size: 1.4rem;">Gestão de Desafios</h3>
                <p class="text-muted" style="font-size: 0.875rem; margin: 0;">Visualize, crie e associe desafios de literacia financeira.</p>
            </div>
            <button type="button" id="openChallengeModalBtn" class="btn btn-primary" style="font-weight: 600; box-shadow: var(--shadow-sm);">
                <i class="fas fa-plus" style="margin-right: 8px;"></i> Criar Novo Desafio
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-lg);">
            @if (!Model.Challenges.Any())
            {
                <div class="card glass-panel text-center" style="grid-column: 1 / -1; padding: var(--spacing-xxl) 0;">
                    <div style="background-color: rgba(12, 115, 183, 0.05); width: 80px; height: 80px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; color: var(--primary-blue); margin-bottom: var(--spacing-md);">
                        <i class="fas fa-trophy fa-3x"></i>
                    </div>
                    <h4 style="font-size: 1.2rem; margin-bottom: var(--spacing-xs); font-weight: 600;">Nenhum Desafio Configurado</h4>
                    <p class="text-muted" style="max-width: 450px; margin: 0 auto var(--spacing-lg) auto; font-size: 0.875rem; line-height: 1.4;">Ainda não existem desafios de simulação registados no sistema. Comece por criar o primeiro desafio clicando abaixo.</p>
                    <button type="button" id="openChallengeModalBtnEmpty" class="btn btn-primary">Criar Primeiro Desafio</button>
                </div>
            }
            else
            {
                @foreach (var c in Model.Challenges)
                {
                    <div class="card glass-panel" style="padding: var(--spacing-lg); display: flex; flex-direction: column; position: relative;">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm);">
                            <div style="display: flex; align-items: center; gap: var(--spacing-sm); overflow: hidden; width: 100%;">
                                <div style="overflow: hidden;">
                                    <h4 style="margin: 0; font-size: 1.1rem; color: var(--dark-grey); font-weight: 700; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@c.Title</h4>
                                </div>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <p class="text-muted" style="font-size: 0.85rem; margin-bottom: var(--spacing-md); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@c.Description</p>
                        }

                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: var(--spacing-sm); color: var(--text-muted); font-size: 0.85rem;">
                            <i class="fas fa-user-graduate" style="color: var(--text-muted); opacity: 0.7;"></i> @(c.Teacher != null ? c.Teacher.Name : "N/A")
                        </div>

                        <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg); color: var(--text-muted); font-size: 0.85rem;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <i class="fas fa-users" style="color: var(--text-muted); opacity: 0.7;"></i> @(c.Scenarios != null ? c.Scenarios.Count : 0) inscritos
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <i class="fas fa-reply" style="color: var(--text-muted); opacity: 0.7;"></i> @(c.Scenarios != null ? c.Scenarios.Sum(s => s.Entries != null ? s.Entries.Count : 0) : 0) respostas
                            </div>
                        </div>

                        <div style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-md);">
                            <div style="font-family: 'Courier New', Courier, monospace; font-size: 1.1rem; font-weight: 700; color: #10b981; letter-spacing: 1px; padding: 6px 12px; background: rgba(16, 185, 129, 0.05); border-radius: var(--radius-sm); border: 1px dashed rgba(16, 185, 129, 0.2);">
                                @c.AccessLinkCode
                            </div>
                            <a href="/Challenges/Details/@c.Id" class="btn btn-outline" style="flex: 1; display: flex; justify-content: center; align-items: center; gap: 6px;">
                                <i class="fas fa-cog"></i> Detalhes
                            </a>
                        </div>
                        
                    </div>
                }
            }
        </div>
    </div>
</div>

<div id="createChallengeModal" class="modal-overlay">
    <div class="modal-card glass-panel">
        <button type="button" class="modal-close-btn" id="closeChallengeModalBtn">
            <i class="fas fa-times"></i>
        </button>
        
        <div style="text-align: left;">
            <div class="flex items-center gap-md mb-2">
                <div style="background-color: rgba(12, 115, 183, 0.1); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                    <i class="fas fa-trophy fa-lg"></i>
                </div>
                <div>
                    <h3 style="color: var(--primary-blue); font-size: 1.35rem; font-weight: 700; margin: 0;">Criar Novo Desafio</h3>
                    <p class="text-muted" style="font-size: 0.8rem; margin: 0;">Configure um desafio de literacia financeira.</p>
                </div>
            </div>
            
            <hr style="border: 0; border-top: 1px solid var(--border-color); margin: var(--spacing-md) 0;" />

            <form asp-controller="Challenges" asp-action="Create" method="post" id="createChallengeForm">
                <div class="form-group">
                    <label for="challengeTitleInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-edit"></i> Título do Desafio
                    </label>
                    <div class="input-icon-group">
                        <input type="text" name="title" id="challengeTitleInput" class="form-control" placeholder="Ex: Simulação Orçamento Familiar" required autocomplete="off" maxlength="255" style="height: 44px; font-size: 0.95rem;" />
                        <i class="fas fa-bullseye"></i>
                    </div>
                </div>

                <div class="form-group" style="margin-top: var(--spacing-md);">
                    <label for="challengeDescInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-align-left"></i> Descrição / Notas (Opcional)
                    </label>
                    <textarea name="description" id="challengeDescInput" class="form-control" placeholder="Descreva brevemente o objetivo do desafio..." style="height: 80px; font-size: 0.9rem; padding: 10px; resize: none;"></textarea>
                </div>

                <div class="form-group" style="margin-top: var(--spacing-md);">
                    <label for="challengeClassSelect" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-graduation-cap"></i> Associar a uma Turma (Opcional)
                    </label>
                    <select name="classId" id="challengeClassSelect" class="form-control" style="height: 44px; font-size: 0.9rem; padding-left: 10px;">
                        <option value="">Nenhuma (Desafio Independente - Acesso por Código)</option>
                        @foreach (var cls in Model.Classes)
                        {
                            <option value="@cls.Id">@cls.Name</option>
                        }
                    </select>
                    <span class="text-muted" style="font-size: 0.775rem; display: block; margin-top: 8px; line-height: 1.4;">
                        <i class="fas fa-info-circle"></i> O desafio receberá um código alfanumérico único para os alunos entrarem diretamente.
                    </span>
                </div>

                <div class="flex gap-md" style="margin-top: var(--spacing-xl); justify-content: flex-end;">
                    <button type="button" class="btn btn-outline" id="cancelChallengeModalBtn" style="padding: 0.55rem var(--spacing-md); font-size: 0.9rem;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="padding: 0.55rem var(--spacing-lg); font-size: 0.9rem; font-weight: 600; box-shadow: var(--shadow-sm);">
                        Criar Desafio <i class="fas fa-plus-circle" style="margin-left: 5px;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const challengeModal = document.getElementById("createChallengeModal");
        const openChallengeModalBtn = document.getElementById("openChallengeModalBtn");
        const openChallengeModalBtnEmpty = document.getElementById("openChallengeModalBtnEmpty");
        const closeChallengeModalBtn = document.getElementById("closeChallengeModalBtn");
        const cancelChallengeModalBtn = document.getElementById("cancelChallengeModalBtn");
        const challengeTitleInput = document.getElementById("challengeTitleInput");

        function openChallengeModal() {
            challengeModal.classList.add("active");
            if (challengeTitleInput) challengeTitleInput.focus();
        }

        function closeChallengeModal() {
            challengeModal.classList.remove("active");
            if (challengeTitleInput) challengeTitleInput.value = "";
            const challengeDescInput = document.getElementById("challengeDescInput");
            if (challengeDescInput) challengeDescInput.value = "";
        }

        if (openChallengeModalBtn) openChallengeModalBtn.addEventListener("click", openChallengeModal);
        if (openChallengeModalBtnEmpty) openChallengeModalBtnEmpty.addEventListener("click", openChallengeModal);
        if (closeChallengeModalBtn) closeChallengeModalBtn.addEventListener("click", closeChallengeModal);
        if (cancelChallengeModalBtn) cancelChallengeModalBtn.addEventListener("click", closeChallengeModal);
        
        challengeModal.addEventListener("click", function(e) {
            if (e.target === challengeModal) {
                closeChallengeModal();
            }
        });

        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && challengeModal.classList.contains("active")) {
                closeChallengeModal();
            }
        });
    });
</script>

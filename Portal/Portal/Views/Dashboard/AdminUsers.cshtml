@model Portal.Models.ViewModels.AdminUsersViewModel

@{
    ViewData["Title"] = "Gestão de Utilizadores";
}

<style>

    .users-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
    }

    @@media (min-width: 1024px) {
        .users-grid {
            grid-template-columns: 1.3fr 0.7fr;
        }
    }

    .badge-role {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
        display: inline-block;
        letter-spacing: 0.5px;
    }

    .role-admin {
        background: rgba(139, 92, 246, 0.1);
        color: #8b5cf6;
    }

    .role-professor {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .role-aluno {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

    .class-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: rgba(12, 115, 183, 0.06);
        border: 1px solid rgba(12, 115, 183, 0.15);
        color: var(--primary-blue);
        padding: 2px 8px;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 600;
        margin: 2px;
    }

    .class-tag-remove-btn {
        background: transparent;
        border: none;
        color: #ef4444;
        cursor: pointer;
        padding: 0;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
    }

    .class-tag-remove-btn:hover {
        transform: scale(1.2);
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: var(--radius-full);
        background-color: rgba(12, 115, 183, 0.1);
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .table-row-hover:hover {
        background-color: rgba(12, 115, 183, 0.02);
    }

    .premium-label {
        font-weight: 600;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-xs);
        font-size: 0.9rem;
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-xl) 0;">



    <div class="users-grid">
        
        <!-- Left: Users List -->
        <div class="card glass-panel" style="padding: var(--spacing-lg);">
            <div style="margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm);">
                <h3 style="color: var(--primary-blue); font-size: 1.25rem;"><i class="fas fa-users" style="margin-right: 8px;"></i> Lista de Utilizadores</h3>
                <p class="text-muted" style="font-size: 0.8rem; margin: 4px 0 0 0;">Visualize e faça a gestão das turmas associadas a cada utilizador do portal.</p>
            </div>

            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color);">
                            <th style="padding: var(--spacing-sm); color: var(--text-muted); font-weight: 600;">Utilizador</th>
                            <th style="padding: var(--spacing-sm); color: var(--text-muted); font-weight: 600;">Papel / Cargo</th>
                            <th style="padding: var(--spacing-sm); color: var(--text-muted); font-weight: 600;">Turmas Inscritas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr style="border-bottom: 1px solid var(--border-color);" class="table-row-hover">
                                <td style="padding: var(--spacing-md) var(--spacing-sm);">
                                    <div class="flex items-center gap-sm">
                                        <div class="user-avatar">
                                            @(!string.IsNullOrWhiteSpace(user.Name) ? user.Name.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div style="font-weight: 600; color: var(--dark-grey);">@user.Name</div>
                                            <div style="font-size: 0.775rem; color: var(--text-muted);">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="padding: var(--spacing-md) var(--spacing-sm);">
                                    @if (user.RoleName == "Admin")
                                    {
                                        <span class="badge-role role-admin">@user.RoleName</span>
                                    }
                                    else
                                    {
                                        <form action="/Dashboard/ChangeUserRole" method="post" style="margin: 0; display: inline-block;">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRoleName" onchange="this.form.submit()" class="ds-dropdown ds-dropdown-compact @(user.RoleName == "Professor" ? "role-professor" : "role-aluno")" data-ds-inline="true">
                                                @if (user.RoleName == "Professor")
                                                {
                                                    <option value="Professor" selected style="background-color: var(--surface-color); color: #f59e0b;">Professor</option>
                                                    <option value="Aluno" style="background-color: var(--surface-color); color: #3b82f6;">Aluno</option>
                                                }
                                                else
                                                {
                                                    <option value="Professor" style="background-color: var(--surface-color); color: #f59e0b;">Professor</option>
                                                    <option value="Aluno" selected style="background-color: var(--surface-color); color: #3b82f6;">Aluno</option>
                                                }
                                            </select>
                                        </form>
                                    }
                                </td>
                                <td style="padding: var(--spacing-md) var(--spacing-sm);">
                                    @if (user.Enrollments.Any())
                                    {
                                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                            @foreach (var enrollment in user.Enrollments)
                                            {
                                                <span class="class-tag">
                                                    @enrollment.ClassName
                                                    <form action="/Classes/RemoveUserFromClass" method="post" style="display: inline;" onsubmit="return confirm('Tem a certeza que deseja remover este utilizador desta turma?')">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <input type="hidden" name="classId" value="@enrollment.ClassId" />
                                                        <button type="submit" class="class-tag-remove-btn" title="Remover da Turma">
                                                            <i class="fas fa-times-circle"></i>
                                                        </button>
                                                    </form>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.8rem; font-style: italic;">Sem turmas associadas</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Enroll User Form -->
        <div class="card glass-panel" style="padding: var(--spacing-lg); height: fit-content;">
            <div style="margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm);">
                <h3 style="color: var(--primary-blue); font-size: 1.2rem;"><i class="fas fa-user-plus" style="margin-right: 8px;"></i> Adicionar Aluno a Turma</h3>
                <p class="text-muted" style="font-size: 0.8rem; margin: 4px 0 0 0;">Inscreva manualmente um utilizador numa turma existente.</p>
            </div>

            <form action="/Classes/EnrollUser" method="post">
                <div class="form-group" style="margin-bottom: var(--spacing-md);">
                    <label for="enrollUserSelect" class="premium-label">
                        <i class="fas fa-user"></i> Selecionar Aluno
                    </label>
                    <select name="userId" id="enrollUserSelect" class="form-control" required>
                        <option value="">-- Selecione o Aluno --</option>
                        @foreach (var user in Model.Users.Where(u => u.RoleName == "Aluno"))
                        {
                            <option value="@user.Id">@user.Name (@user.Email)</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: var(--spacing-lg);">
                    <label for="enrollClassSelect" class="premium-label">
                        <i class="fas fa-graduation-cap"></i> Selecionar Turma
                    </label>
                    <select name="classId" id="enrollClassSelect" class="form-control" required>
                        <option value="">-- Selecione a Turma --</option>
                        @foreach (var cls in Model.Classes)
                        {
                            <option value="@cls.Id">@cls.Name</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; height: 44px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i class="fas fa-plus-circle"></i> Adicionar à Turma
                </button>
            </form>
        </div>

    </div>

</div>

@model Portal.Models.ViewModels.AdminUsersViewModel

@{
    ViewData["Title"] = "Gestão de Utilizadores";
}

<style>
    .admin-tabs {
        display: flex;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: var(--spacing-xl);
        gap: var(--spacing-md);
        flex-wrap: wrap;
    }

    .tab-btn {
        background: transparent;
        border: none;
        padding: var(--spacing-md) var(--spacing-lg);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        cursor: pointer;
        transition: var(--transition);
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .tab-btn:hover {
        color: var(--primary-blue);
    }

    .tab-btn.active {
        color: var(--primary-blue);
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--primary-blue);
    }

    .users-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
    }



    .badge-role {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: var(--radius-sm);
        text-transform: uppercase;
        display: inline-block;
        letter-spacing: 0.5px;
    }

    .role-admin {
        background: rgba(139, 92, 246, 0.1);
        color: #8b5cf6;
    }

    .role-professor {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .role-aluno {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

    .class-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: rgba(12, 115, 183, 0.06);
        border: 1px solid rgba(12, 115, 183, 0.15);
        color: var(--primary-blue);
        padding: 2px 8px;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 600;
        margin: 2px;
    }

    .class-tag-remove-btn {
        background: transparent;
        border: none;
        color: #ef4444;
        cursor: pointer;
        padding: 0;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
    }

    .class-tag-remove-btn:hover {
        transform: scale(1.2);
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: var(--radius-full);
        background-color: rgba(12, 115, 183, 0.1);
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .table-row-hover:hover {
        background-color: rgba(12, 115, 183, 0.02);
    }

    .premium-label {
        font-weight: 600;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-xs);
        font-size: 0.9rem;
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-md) 0 var(--spacing-xl) 0;">

    <!-- Navigation Tabs -->


            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-md);">
                @foreach (var user in Model.Users)
                {
                    <div style="background: rgba(12, 115, 183, 0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: var(--spacing-md); display: flex; flex-direction: column;">
                        
                        <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-sm);">
                            <div class="user-avatar">
                                @(!string.IsNullOrWhiteSpace(user.Name) ? user.Name.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div style="flex: 1; overflow: hidden;">
                                <div style="font-weight: 700; color: var(--dark-grey); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Name</div>
                                <div style="font-size: 0.775rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Email</div>
                            </div>
                        </div>

                        <div style="margin-bottom: var(--spacing-md); display: flex; align-items: center; justify-content: space-between;">
                            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Função</span>
                            @if (user.RoleName == "Admin")
                            {
                                <span class="badge-role role-admin">@user.RoleName</span>
                            }
                            else if (user.RoleName == "Professor")
                            {
                                <span class="badge-role role-professor">@user.RoleName</span>
                            }
                            else
                            {
                                <span class="badge-role role-aluno">@user.RoleName</span>
                            }
                        </div>


                        <div style="margin-top: var(--spacing-sm);">
                            <a href="/Dashboard/UserDetails/@user.Id" class="btn btn-outline" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 6px;">
                                <i class="fas fa-cog"></i> Detalhes
                            </a>
                        </div>

                    </div>
                }
            </div>


    </div>

</div>

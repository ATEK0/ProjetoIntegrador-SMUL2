@model Portal.Models.ViewModels.AdminInfraViewModel

@{
    ViewData["Title"] = "Administração";
}

<style>
    .infra-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-xl);
    }

    .infra-card {
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .infra-card:hover {
        border-color: var(--primary-blue);
        box-shadow: var(--shadow-md);
    }

    .infra-card .icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: var(--spacing-sm);
    }

    .infra-card .count {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--dark-grey);
        line-height: 1.2;
    }

    .infra-card .label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .health-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--spacing-lg);
    }

    .health-card {
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        border: 1px solid var(--border-color);
        background: var(--white);
    }

    .health-card h3 {
        margin: 0 0 var(--spacing-md) 0;
        font-size: 1rem;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    .status-online { background: #10b981; }
    .status-offline { background: #ef4444; }
    .status-checking { background: #f59e0b; }

    .health-detail {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin: 4px 0;
    }

    .health-detail strong {
        color: var(--dark-grey);
    }

    .health-meta {
        margin-top: var(--spacing-md);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--border-color);
        font-size: 0.8rem;
        color: var(--text-muted);
    }
</style>

<div class="container dashboard-page">

    <partial name="_DashboardPageHeader" model='new DashboardPageHeaderViewModel { Title = "Administração", Subtitle = "Monitorização da infraestrutura e acesso rápido à gestão." }' />

    <div class="infra-grid">
        <a href="/Dashboard/AdminUsers" class="infra-card">
            <div class="icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;"><i class="fas fa-users-cog"></i></div>
            <div class="count">@Model.TotalUsers</div>
            <div class="label">Utilizadores</div>
        </a>
        <a href="/Dashboard/AdminClasses" class="infra-card">
            <div class="icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;"><i class="fas fa-graduation-cap"></i></div>
            <div class="count">@Model.TotalClasses</div>
            <div class="label">Turmas</div>
        </a>
        <a href="/Dashboard/AdminChallenges" class="infra-card">
            <div class="icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;"><i class="fas fa-trophy"></i></div>
            <div class="count">@Model.TotalChallenges</div>
            <div class="label">Desafios</div>
        </a>
        <a href="/Dashboard/AdminAuditLogs" class="infra-card">
            <div class="icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="fas fa-clipboard-list"></i></div>
            <div class="count">@Model.TotalAuditLogs</div>
            <div class="label">Audit Logs</div>
        </a>
    </div>

    <div class="health-grid">
        <div class="health-card glass-panel">
            <h3>
                <span id="ms-dot" class="status-dot status-checking"></span>
                MS-CAFIN (Microserviço)
            </h3>
            <div id="ms-status-text" class="health-detail">A verificar ligação...</div>
            <div id="ms-service" class="health-detail" style="display:none;">Serviço: <strong id="ms-service-val"></strong></div>
            <div id="ms-version" class="health-detail" style="display:none;">Versão: <strong id="ms-version-val"></strong></div>
            <div id="ms-error" class="health-detail" style="display:none; color: #ef4444;">Erro: <strong id="ms-error-val"></strong></div>
            <div class="health-meta">
                <i class="fas fa-sync-alt"></i> Atualização automática a cada 15s
                <span id="ms-last-check"></span>
            </div>
        </div>

        <div class="health-card glass-panel">
            <h3>
                <span class="status-dot @(Model.DatabaseOnline ? "status-online" : "status-offline")"></span>
                Base de Dados (MySQL)
            </h3>
            <div class="health-detail">
                Estado: <strong>@(Model.DatabaseOnline ? "Ligada" : "Indisponível")</strong>
            </div>
            <div class="health-meta">
                Verificado no carregamento da página
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const dot = document.getElementById('ms-dot');
    const statusText = document.getElementById('ms-status-text');
    const serviceRow = document.getElementById('ms-service');
    const serviceVal = document.getElementById('ms-service-val');
    const versionRow = document.getElementById('ms-version');
    const versionVal = document.getElementById('ms-version-val');
    const errorRow = document.getElementById('ms-error');
    const errorVal = document.getElementById('ms-error-val');
    const lastCheck = document.getElementById('ms-last-check');

    async function checkMsHealth() {
        dot.className = 'status-dot status-checking';
        statusText.innerHTML = 'A verificar ligação...';

        try {
            const res = await fetch('/Dashboard/MsHealth');
            const data = await res.json();

            if (data.isOnline) {
                dot.className = 'status-dot status-online';
                statusText.innerHTML = 'Estado: <strong>Online</strong> (' + data.responseTimeMs + 'ms)';
                serviceRow.style.display = 'block';
                serviceVal.textContent = data.service || 'MS-CAFIN';
                versionRow.style.display = data.version ? 'block' : 'none';
                versionVal.textContent = data.version || '';
                errorRow.style.display = 'none';
            } else {
                dot.className = 'status-dot status-offline';
                statusText.innerHTML = 'Estado: <strong>Offline</strong>';
                serviceRow.style.display = 'none';
                versionRow.style.display = 'none';
                errorRow.style.display = 'block';
                errorVal.textContent = data.error || 'Sem resposta';
            }

            const t = new Date(data.checkedAt || Date.now());
            lastCheck.textContent = ' — última verificação: ' + t.toLocaleTimeString('pt-PT');
        } catch (e) {
            dot.className = 'status-dot status-offline';
            statusText.innerHTML = 'Estado: <strong>Offline</strong>';
            errorRow.style.display = 'block';
            errorVal.textContent = e.message;
        }
    }

    checkMsHealth();
    setInterval(checkMsHealth, 15000);
})();
</script>
}

@model Portal.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Administração";
}

<style>
    .admin-stat-card {
        background: var(--surface-color);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

    .admin-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }

    .admin-stat-icon {
        width: 60px;
        height: 60px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .admin-stat-content h3 {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .admin-stat-content .value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--dark-grey);
        margin-top: 4px;
        line-height: 1;
    }

    .icon-users { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .icon-classes { background-color: rgba(16, 185, 129, 0.1); color: #10b981; }
    .icon-challenges { background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    
    .status-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #10b981;
        margin-right: 8px;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-xl) 0;">

    <div class="flex justify-between items-center" style="margin-bottom: var(--spacing-lg);">
        <div>
            <h3 style="color: var(--primary-blue); margin-bottom: 4px; font-size: 1.5rem;">Visão Geral do Sistema</h3>
            <p class="text-muted" style="font-size: 0.9rem; margin: 0;">Resumo da infraestrutura e dados do Portal DEC.</p>
        </div>

    </div>

    <!-- Key Metrics Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg); margin-bottom: var(--spacing-xl);">
        
        <div class="admin-stat-card glass-panel">
            <div class="admin-stat-icon icon-users">
                <i class="fas fa-users"></i>
            </div>
            <div class="admin-stat-content">
                <h3>Total Utilizadores</h3>
                <div class="value">@Model.Users.Count()</div>
            </div>
        </div>

        <div class="admin-stat-card glass-panel">
            <div class="admin-stat-icon icon-classes">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="admin-stat-content">
                <h3>Turmas Ativas</h3>
                <div class="value">@Model.Classes.Count()</div>
            </div>
        </div>

        <div class="admin-stat-card glass-panel">
            <div class="admin-stat-icon icon-challenges">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="admin-stat-content">
                <h3>Desafios Criados</h3>
                <div class="value">@Model.Challenges.Count()</div>
            </div>
        </div>

    </div>

    <!-- Secondary Grid: Quick Actions and System Info -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--spacing-lg);">
        
        <!-- System Configuration Info -->
        <div class="card glass-panel">
            <h3 style="margin-bottom: var(--spacing-md); color: var(--dark-grey); font-size: 1.2rem;"><i class="fas fa-server" style="margin-right: 8px; color: var(--primary-blue);"></i> Informação da Infraestrutura</h3>
            
            <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
                <div style="display: flex; justify-content: space-between; padding: var(--spacing-sm); border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted); font-weight: 600;">Estado do Servidor Web</span>
                    <span style="color: #10b981; font-weight: 700;">Online</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: var(--spacing-sm); border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted); font-weight: 600;">Ligação à Base de Dados (MySQL)</span>
                    <span style="color: #10b981; font-weight: 700;">Sincronizada</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: var(--spacing-sm); border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted); font-weight: 600;">Autenticação (JWT)</span>
                    <span style="color: #10b981; font-weight: 700;">Segura</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: var(--spacing-sm);">
                    <span style="color: var(--text-muted); font-weight: 600;">Ambiente</span>
                    <span style="color: var(--primary-blue); font-weight: 700;">Produção</span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card glass-panel" style="display: flex; flex-direction: column;">
            <h3 style="margin-bottom: var(--spacing-md); color: var(--dark-grey); font-size: 1.2rem;"><i class="fas fa-bolt" style="margin-right: 8px; color: #f59e0b;"></i> Ações Rápidas</h3>
            
            <div style="display: flex; flex-direction: column; gap: var(--spacing-sm); flex-grow: 1;">
                <a href="/Dashboard/AdminUsers" class="btn btn-outline" style="justify-content: flex-start; text-decoration: none;">
                    <i class="fas fa-user-shield" style="margin-right: 8px;"></i> Gerir Permissões
                </a>
                <a href="/Classes/Create" class="btn btn-outline" style="justify-content: flex-start; text-decoration: none;">
                    <i class="fas fa-plus-circle" style="margin-right: 8px;"></i> Nova Turma
                </a>
                <a href="/Challenges/Create" class="btn btn-outline" style="justify-content: flex-start; text-decoration: none;">
                    <i class="fas fa-plus-circle" style="margin-right: 8px;"></i> Novo Desafio
                </a>
            </div>
        </div>

    </div>

</div>

@{
    ViewData["Title"] = "Dashboard Professor";
}

<div class="dashboard-grid">
    <!-- Stats Cards -->
    <div class="card glass-panel" style="grid-column: span 2;">
        <h3 style="margin-bottom: var(--spacing-md); color: var(--primary-blue);">Estatísticas das Turmas</h3>
        <div class="flex gap-lg">
            <div class="stat-card" style="flex: 1;">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-details">
                    <h3>Total Alunos</h3>
                    <div class="value">124</div>
                </div>
            </div>
            <div class="stat-card" style="flex: 1;">
                <div class="stat-icon"><i class="fas fa-tasks"></i></div>
                <div class="stat-details">
                    <h3>Desafios Ativos</h3>
                    <div class="value">5</div>
                </div>
            </div>
            <div class="stat-card" style="flex: 1; border-left-color: #10b981;">
                <div class="stat-icon" style="color: #10b981; background-color: rgba(16,185,129,0.1);"><i class="fas fa-check-circle"></i></div>
                <div class="stat-details">
                    <h3>Submissões Pendentes</h3>
                    <div class="value">12</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <h3 style="margin-bottom: var(--spacing-md);">Gestão Pedagógica</h3>
        <div class="flex flex-col gap-sm">
            <button class="btn btn-primary" style="justify-content: flex-start;"><i class="fas fa-plus" style="margin-right: 8px;"></i> Criar Desafio</button>
            <button class="btn btn-outline" style="justify-content: flex-start;"><i class="fas fa-users-cog" style="margin-right: 8px;"></i> Gerir Turmas</button>
            <button class="btn btn-outline" style="justify-content: flex-start;"><i class="fas fa-chart-line" style="margin-right: 8px;"></i> Ver Relatórios</button>
        </div>
    </div>
</div>

<div class="card glass-panel">
    <h3 style="margin-bottom: var(--spacing-md);">Desafios Recentes</h3>
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color);">
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Desafio</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Turma</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Progresso</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Ação</th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: var(--spacing-sm);">Orçamento Familiar - Mês 1</td>
                <td style="padding: var(--spacing-sm);">10º A</td>
                <td style="padding: var(--spacing-sm);">
                    <div style="background-color: var(--border-color); height: 8px; border-radius: 4px; width: 100%; max-width: 150px;">
                        <div style="background-color: var(--primary-blue); height: 100%; width: 75%; border-radius: 4px;"></div>
                    </div>
                    <span style="font-size: 0.75rem; color: var(--text-muted);">75% Concluído</span>
                </td>
                <td style="padding: var(--spacing-sm);"><button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Avaliar (5)</button></td>
            </tr>
            <tr>
                <td style="padding: var(--spacing-sm);">Simulação Crédito Habitação</td>
                <td style="padding: var(--spacing-sm);">12º B</td>
                <td style="padding: var(--spacing-sm);">
                    <div style="background-color: var(--border-color); height: 8px; border-radius: 4px; width: 100%; max-width: 150px;">
                        <div style="background-color: var(--primary-blue); height: 100%; width: 20%; border-radius: 4px;"></div>
                    </div>
                    <span style="font-size: 0.75rem; color: var(--text-muted);">20% Concluído</span>
                </td>
                <td style="padding: var(--spacing-sm);"><button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Monitorizar</button></td>
            </tr>
        </tbody>
    </table>
</div>

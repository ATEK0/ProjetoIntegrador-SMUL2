@model Portal.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Aluno";
}

<style>
    .student-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
        margin-top: var(--spacing-lg);
    }

    @@media (min-width: 1024px) {
        .student-grid {
            grid-template-columns: 1.5fr 1fr;
        }
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .scenario-card {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        transition: var(--transition);
        cursor: pointer;
    }

    .scenario-card:hover {
        background: rgba(12, 115, 183, 0.04);
        border-color: rgba(12, 115, 183, 0.3);
        box-shadow: var(--shadow-sm);
        transform: translateY(-2px);
    }

    .scenario-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .scenario-balance {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--primary-blue);
    }

    .scenario-meta {
        font-size: 0.78rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-xl) var(--spacing-md);
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: var(--radius-full);
        background: rgba(12, 115, 183, 0.06);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-blue);
        margin-bottom: var(--spacing-md);
    }

    .class-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .class-icon {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .challenge-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-left: 4px solid #f59e0b;
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        transition: var(--transition);
    }

    .challenge-card:hover {
        transform: translateX(4px);
        box-shadow: var(--shadow-sm);
    }

    /* Modal Premium Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        padding: var(--spacing-md);
    }

    .modal-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .modal-card {
        background: var(--surface-color);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: var(--shadow-lg);
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        overflow-y: auto;
        padding: var(--spacing-xl);
        position: relative;
        transform: scale(0.95) translateY(15px);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-overlay.active .modal-card {
        transform: scale(1) translateY(0);
    }

    .modal-close-btn {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        background: transparent;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        color: var(--text-muted);
        transition: var(--transition);
        width: 32px;
        height: 32px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        background-color: rgba(0, 0, 0, 0.05);
        color: var(--text-main);
    }

    .input-icon-group {
        position: relative;
    }

    .input-icon-group i {
        position: absolute;
        left: var(--spacing-md);
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        transition: var(--transition);
        font-size: 1.1rem;
    }

    .input-icon-group .form-control {
        padding-left: 2.75rem;
        font-size: 1.05rem;
        height: 50px;
    }

    .input-icon-group .form-control:focus + i {
        color: var(--primary-blue);
    }

    .premium-label {
        font-weight: 600;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-xs);
        font-size: 0.95rem;
    }
</style>

<div class="container animate-fade-in" style="padding: var(--spacing-lg) 0;">

    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #065f46;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash error" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #991b1b;">
            @TempData["Error"]
        </div>
    }

    <!-- Top Greeting -->
    <div class="flex justify-between items-center" style="margin-bottom: var(--spacing-lg);">
        <div>
            <h2 style="color: var(--primary-blue); font-weight: 700; margin-bottom: 4px;">
                Olá, @Model.StudentName!
            </h2>
            <p class="text-muted" style="margin: 0; font-size: 0.9rem;">
                Acompanha as tuas turmas, desafios e gere os teus cenários de simulação financeira.
            </p>
        </div>
        <button id="btn-criar-cenario" class="btn btn-primary" style="font-size: 0.9rem; padding: 0.5rem 1rem; box-shadow: var(--shadow-sm);">
            <i class="fas fa-plus-circle" style="margin-right: 6px;"></i> Novo Cenário
        </button>
    </div>

    <!-- Stats Row -->
    <div class="stat-row">
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: #3b82f6; background-color: rgba(59, 130, 246, 0.1);">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="stat-details">
                <h3>Turmas Inscritas</h3>
                <div class="value">@Model.EnrolledClasses.Count</div>
            </div>
        </div>
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: var(--primary-blue); background-color: rgba(12, 115, 183, 0.1);">
                <i class="fas fa-home"></i>
            </div>
            <div class="stat-details">
                <h3>Cenários Criados</h3>
                <div class="value">@Model.Scenarios.Count</div>
            </div>
        </div>
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: #f59e0b; background-color: rgba(245, 158, 11, 0.1);">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-details">
                <h3>Desafios Ativos</h3>
                <div class="value">@Model.PendingChallenges.Count</div>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="student-grid">

        <!-- Left Column: Classes and Challenges -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <!-- Enrolled Classes -->
            <div class="card glass-panel" style="padding: var(--spacing-lg);">
                <div class="flex justify-between items-center" style="margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm);">
                    <h3 style="color: var(--dark-grey); font-size: 1.15rem; margin: 0;">
                        <i class="fas fa-chalkboard" style="color: var(--primary-blue); margin-right: 8px;"></i> As Minhas Turmas
                    </h3>
                    <a href="#" onclick="openJoinModal(event)" class="btn btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none;">
                        <i class="fas fa-plus" style="margin-right: 4px;"></i> Aderir
                    </a>
                </div>

                @if (!Model.EnrolledClasses.Any())
                {
                    <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 0.85rem;">
                        Não estás inscrito em nenhuma turma no momento.<br />
                        <span style="font-size: 0.8rem;">Pede o código de adesão ao teu professor.</span><br />
                        <a href="#" onclick="openJoinModal(event)" class="btn btn-primary" style="margin-top: 12px; font-size: 0.8rem; padding: 0.4rem 0.8rem; text-decoration: none; display: inline-block;">
                            <i class="fas fa-sign-in-alt" style="margin-right: 6px;"></i> Aderir com Código
                        </a>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
                        @foreach (var c in Model.EnrolledClasses)
                        {
                            <div class="class-card">
                                <div class="class-icon"><i class="fas fa-graduation-cap"></i></div>
                                <div>
                                    <h4 style="margin: 0; font-size: 1rem; color: var(--dark-grey); font-weight: 700;">@c.ClassName</h4>
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">Turma Ativa</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Pending Challenges -->
            <div class="card glass-panel" style="padding: var(--spacing-lg);">
                <h3 style="color: var(--dark-grey); font-size: 1.15rem; margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm);">
                    <i class="fas fa-trophy" style="color: #f59e0b; margin-right: 8px;"></i> Desafios das Turmas
                </h3>

                @if (!Model.PendingChallenges.Any())
                {
                    <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 0.85rem;">
                        Sem desafios ativos de momento.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-md);">
                        @foreach (var challenge in Model.PendingChallenges)
                        {
                            <div class="challenge-card">
                                <h4 style="margin: 0 0 4px 0; font-size: 1.05rem; color: var(--dark-grey); font-weight: 700;">@challenge.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(challenge.Description))
                                {
                                    <p style="margin: 0 0 8px 0; font-size: 0.85rem; color: var(--text-muted);">@challenge.Description</p>
                                }
                                <div style="font-size: 0.8rem; display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: var(--primary-blue); font-weight: 600;"><i class="fas fa-users"></i> @challenge.Class.Name</span>
                                @if (challenge.Type == Portal.Models.Enums.ChallengeType.Quiz)
                                    {
                                        <a href="/Challenges/SolveQuiz/@challenge.Id" class="btn btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none; color: #f59e0b; border-color: #f59e0b;">
                                            Resolver Quiz <i class="fas fa-arrow-right" style="margin-left: 4px;"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Scenarios/Create" class="btn btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none;">
                                            Resolver Desafio <i class="fas fa-arrow-right" style="margin-left: 4px;"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- Right Column: Scenarios List -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            
            <div class="card glass-panel" style="padding: var(--spacing-lg); height: 100%;">
                <h3 style="color: var(--primary-blue); font-size: 1.25rem; margin-bottom: var(--spacing-md); border-bottom: 1px solid var(--border-color); padding-bottom: var(--spacing-sm);">
                    <i class="fas fa-home" style="margin-right: 8px;"></i> Os Meus Cenários
                </h3>

                @if (!Model.Scenarios.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                        <h4 style="font-size: 1.05rem; margin-bottom: var(--spacing-xs); font-weight: 600;">
                            Ainda não tens cenários
                        </h4>
                        <p class="text-muted" style="font-size: 0.85rem; max-width: 300px; margin: 0 auto var(--spacing-md) auto;">
                            Cria o teu primeiro cenário familiar para começar a simular receitas, despesas e objetivos financeiros.
                        </p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--spacing-md);">
                        @foreach (var scenario in Model.Scenarios)
                        {
                            <a href="/Scenarios/Details/@scenario.Id" style="text-decoration: none; color: inherit;">
                                <div class="scenario-card">
                                    <div class="scenario-card-header">
                                        <div>
                                            <h4 style="font-weight: 700; color: var(--primary-blue); margin: 0; font-size: 1rem;">
                                                <i class="fas fa-home" style="margin-right: 6px; font-size: 0.9rem;"></i>
                                                @scenario.FamilyName
                                            </h4>
                                        </div>
                                    </div>

                                    <div class="scenario-balance">
                                        € @scenario.InitialBalance.ToString("N2")
                                        <span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted); margin-left: 4px;">saldo total</span>
                                    </div>

                                    <div class="flex justify-between items-center" style="margin-top: 4px;">
                                        <span class="scenario-meta">
                                            <i class="fas fa-calendar-alt"></i>
                                            Criado em @scenario.CreatedAt.ToString("dd MMM yyyy")
                                        </span>
                                        <span class="btn btn-primary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none;">
                                            Ver Orçamento
                                        </span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

        </div>
   <!-- Modal Aderir Turma Premium -->
<div id="joinClassModal" class="modal-overlay">
    <div class="modal-card glass-panel">
        <button type="button" class="modal-close-btn" id="closeJoinModalBtn">
            <i class="fas fa-times"></i>
        </button>
        
        <div style="text-align: left;">
            <div class="flex items-center gap-md mb-2">
                <div style="background-color: rgba(12, 115, 183, 0.1); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                    <i class="fas fa-sign-in-alt fa-lg"></i>
                </div>
                <div>
                    <h3 style="color: var(--primary-blue); font-size: 1.35rem; font-weight: 700; margin: 0;">Aderir à Turma</h3>
                    <p class="text-muted" style="font-size: 0.8rem; margin: 0;">Junta-te a uma turma de simulação.</p>
                </div>
            </div>
            
            <hr style="border: 0; border-top: 1px solid var(--border-color); margin: var(--spacing-md) 0;" />

            <form action="/Classes/Join" method="post" id="joinClassForm">
                <div class="form-group">
                    <label for="joinCodeInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-key"></i> Código de Adesão
                    </label>
                    <div class="input-icon-group">
                        <input type="text" name="membershipCode" id="joinCodeInput" class="form-control" placeholder="EX: K9X2WP" required autocomplete="off" maxlength="6" style="height: 44px; font-size: 1.15rem; font-weight: 700; letter-spacing: 4px; text-transform: uppercase;" />
                        <i class="fas fa-hashtag"></i>
                    </div>
                    <span class="text-muted" style="font-size: 0.775rem; display: block; margin-top: 8px; line-height: 1.4;">
                        <i class="fas fa-info-circle"></i> O código único tem 6 dígitos. Pede ao teu professor.
                    </span>
                </div>

                <div class="flex gap-md" style="margin-top: var(--spacing-xl); justify-content: flex-end;">
                    <button type="button" class="btn btn-outline" id="cancelJoinModalBtn" style="padding: 0.55rem var(--spacing-md); font-size: 0.9rem;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="padding: 0.55rem var(--spacing-lg); font-size: 0.9rem; font-weight: 600; box-shadow: var(--shadow-sm);">
                        Entrar na Turma <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Tornado global para o inline onclick
    window.openJoinModal = function(e) {
        if(e) e.preventDefault();
        var modal = document.getElementById('joinClassModal');
        modal.classList.add('active');
        
        var input = document.getElementById('joinCodeInput');
        if (input) {
            input.value = '';
            setTimeout(function() { input.focus(); }, 100);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("btn-criar-cenario");
        var btnEmpty = document.getElementById("btn-criar-cenario-empty");
        
        function openScenarioModal(e) {
            if (e) e.preventDefault();
            window.location.href = "/Scenarios/Create";
        }

        if (btn) btn.addEventListener("click", openScenarioModal);
        if (btnEmpty) btnEmpty.addEventListener("click", openScenarioModal);

        // Lógica de fecho do Modal Premium
        const joinModal = document.getElementById("joinClassModal");
        const closeBtn = document.getElementById("closeJoinModalBtn");
        const cancelBtn = document.getElementById("cancelJoinModalBtn");

        function closeJoinModalFunc() {
            joinModal.classList.remove("active");
        }

        if (closeBtn) closeBtn.addEventListener("click", closeJoinModalFunc);
        if (cancelBtn) cancelBtn.addEventListener("click", closeJoinModalFunc);
        
        if (joinModal) {
            joinModal.addEventListener("click", function(e) {
                if (e.target === joinModal) {
                    closeJoinModalFunc();
                }
            });
        }
        
        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && joinModal && joinModal.classList.contains("active")) {
                closeJoinModalFunc();
            }
        });

        // Formatação do input do código da turma
        var joinInput = document.getElementById('joinCodeInput');
        if(joinInput) {
            joinInput.addEventListener('input', function(e) {
                var v = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                if(v.length > 6) v = v.slice(0,6);
                e.target.value = v;
            });
        }

        // Auto-dismiss flash messages after 5s
        ["flash-success", "flash-error"].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) setTimeout(function(){ el.style.transition="opacity .4s"; el.style.opacity="0"; setTimeout(function(){ el.remove(); }, 400); }, 5000);
        });
    });
</script>

@{
    ViewData["Title"] = "Dashboard Aluno";
}

<div class="dashboard-grid">
    <!-- Balance/Savings Card -->
    <div class="card glass-panel" style="grid-column: span 2;">
        <h3 style="margin-bottom: var(--spacing-md); color: var(--primary-blue);">Resumo da Família Virtual</h3>
        <div class="flex gap-lg">
            <div class="stat-card" style="flex: 1;">
                <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                <div class="stat-details">
                    <h3>Saldo Atual</h3>
                    <div class="value">€ 1.250,00</div>
                </div>
            </div>
            <div class="stat-card" style="flex: 1;">
                <div class="stat-icon"><i class="fas fa-piggy-bank"></i></div>
                <div class="stat-details">
                    <h3>Poupança (Fundo Emergência)</h3>
                    <div class="value">€ 3.400,00</div>
                </div>
            </div>
            <div class="stat-card" style="flex: 1; border-left-color: #ef4444;">
                <div class="stat-icon" style="color: #ef4444; background-color: rgba(239,68,68,0.1);"><i class="fas fa-chart-pie"></i></div>
                <div class="stat-details">
                    <h3>Taxa de Esforço</h3>
                    <div class="value">32%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <h3 style="margin-bottom: var(--spacing-md);">Ações Rápidas</h3>
        <div class="flex flex-col gap-sm">
            <button class="btn btn-outline" style="justify-content: flex-start;"><i class="fas fa-plus" style="margin-right: 8px;"></i> Registar Despesa</button>
            <button class="btn btn-outline" style="justify-content: flex-start;"><i class="fas fa-plus" style="margin-right: 8px;"></i> Registar Rendimento</button>
            <button class="btn btn-primary" style="justify-content: flex-start;"><i class="fas fa-calculator" style="margin-right: 8px;"></i> Simular Crédito</button>
        </div>
    </div>
</div>

<div class="card glass-panel">
    <h3 style="margin-bottom: var(--spacing-md);">Desafios do Professor</h3>
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color);">
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Desafio</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Prazo</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Estado</th>
                <th style="padding: var(--spacing-sm); color: var(--text-muted);">Ação</th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: var(--spacing-sm);">Constituir Fundo de Emergência</td>
                <td style="padding: var(--spacing-sm);">31 Mai 2026</td>
                <td style="padding: var(--spacing-sm);"><span style="color: #f59e0b; font-weight: bold;">Em curso</span></td>
                <td style="padding: var(--spacing-sm);"><button class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Ver</button></td>
            </tr>
            <tr>
                <td style="padding: var(--spacing-sm);">Simulação Crédito Habitação</td>
                <td style="padding: var(--spacing-sm);">15 Jun 2026</td>
                <td style="padding: var(--spacing-sm);"><span style="color: var(--text-muted);">Pendente</span></td>
                <td style="padding: var(--spacing-sm);"><button class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Iniciar</button></td>
            </tr>
        </tbody>
    </table>
</div>

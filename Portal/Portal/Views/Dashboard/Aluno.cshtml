@model Portal.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Aluno";
}

<div class="container dashboard-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #065f46;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash error" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); padding: 12px; margin-bottom: 16px; border-radius: 8px; color: #991b1b;">
            @TempData["Error"]
        </div>
    }

    <div class="dashboard-top">
        <partial name="_DashboardPageHeader" model='new DashboardPageHeaderViewModel { Title = "Painel do Aluno", Subtitle = $"Olá, {Model.StudentName}. Acompanha turmas, desafios e cenários." }' />
        <div style="display: flex; gap: var(--spacing-sm);">
            <a href="/Dashboard/AlunoClasses" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                <i class="fas fa-chalkboard"></i> Turmas
            </a>
            <a href="/Dashboard/AlunoChallenges" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                <i class="fas fa-trophy"></i> Desafios
            </a>
            <a href="/Dashboard/AlunoScenarios" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                <i class="fas fa-home"></i> Cenários
            </a>
        </div>
    </div>

    <div class="dashboard-stat-row">
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: #3b82f6; background-color: rgba(59, 130, 246, 0.1);">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="stat-details">
                <h3>Turmas Inscritas</h3>
                <div class="value">@Model.EnrolledClasses.Count</div>
            </div>
        </div>
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: var(--primary-blue); background-color: rgba(12, 115, 183, 0.1);">
                <i class="fas fa-home"></i>
            </div>
            <div class="stat-details">
                <h3>Cenários Criados</h3>
                <div class="value">@Model.Scenarios.Count</div>
            </div>
        </div>
        <div class="stat-card card glass-panel">
            <div class="stat-icon" style="color: #f59e0b; background-color: rgba(245, 158, 11, 0.1);">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-details">
                <h3>Desafios Ativos</h3>
                <div class="value">@Model.PendingChallenges.Count(c => !c.IsSubmitted)</div>
            </div>
        </div>
    </div>

    <div class="card glass-panel" style="padding: var(--spacing-xl); text-align: center; margin-top: var(--spacing-xl);">
        <div style="background-color: rgba(12, 115, 183, 0.05); width: 80px; height: 80px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; color: var(--primary-blue); margin-bottom: var(--spacing-md);">
            <i class="fas fa-rocket fa-3x"></i>
        </div>
        <h4 style="font-size: 1.25rem; font-weight: 700; color: var(--dark-grey); margin-bottom: var(--spacing-sm);">Tudo Pronto Para a Ação!</h4>
        <p class="text-muted" style="max-width: 500px; margin: 0 auto; font-size: 0.95rem; line-height: 1.5;">
            Usa a barra lateral ou os botões no topo para aceder às tuas turmas, participar nos teus desafios e gerir os teus cenários de simulação financeira.
        </p>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Auto-dismiss flash messages after 5s
        ["flash-success", "flash-error"].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) setTimeout(function(){ el.style.transition="opacity .4s"; el.style.opacity="0"; setTimeout(function(){ el.remove(); }, 400); }, 5000);
        });
    });
</script>

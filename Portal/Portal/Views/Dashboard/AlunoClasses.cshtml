@model Portal.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "As Minhas Turmas";
}

<div class="container dashboard-page">
    <div class="dashboard-top">
        <partial name="_DashboardPageHeader" model='new DashboardPageHeaderViewModel { Title = "As Minhas Turmas", Subtitle = "Consulte as turmas onde está inscrito." }' />
        <button type="button" onclick="openJoinModal(event)" class="btn btn-primary">
            <i class="fas fa-plus" style="margin-right: 8px;"></i> Aderir a Turma
        </button>
    </div>

    <div>
        @if (!Model.EnrolledClasses.Any())
        {
            <div class="card glass-panel text-center" style="grid-column: 1 / -1; padding: var(--spacing-xxl) 0;">
                <div style="background-color: rgba(12, 115, 183, 0.05); width: 80px; height: 80px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; color: var(--primary-blue); margin-bottom: var(--spacing-md);">
                    <i class="fas fa-chalkboard fa-3x"></i>
                </div>
                <h4 style="font-size: 1.2rem; margin-bottom: var(--spacing-xs); font-weight: 600;">Sem Turmas Inscritas</h4>
                <p class="text-muted" style="max-width: 450px; margin: 0 auto; font-size: 0.875rem; line-height: 1.4;">Ainda não aderiu a nenhuma turma de simulação. Pede o código ao teu professor e junta-te para aceder a desafios!</p>
                <div style="margin-top: var(--spacing-md);">
                    <button type="button" class="btn btn-outline" onclick="openJoinModal(event)" style="padding: 0.4rem 1rem; font-size: 0.85rem;">Aderir a Turma</button>
                </div>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-lg);">
                @foreach (var c in Model.EnrolledClasses)
                {
                    <div class="card glass-panel" style="padding: var(--spacing-lg); display: flex; flex-direction: column; position: relative;">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm);">
                            <div style="display: flex; align-items: center; gap: var(--spacing-sm); overflow: hidden; width: 100%;">
                                <div style="overflow: hidden;">
                                    <h4 style="margin: 0; font-size: 1.1rem; color: var(--dark-grey); font-weight: 700; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@c.ClassName</h4>
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg); color: var(--text-muted); font-size: 0.85rem;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <i class="fas fa-check-circle" style="color: #10b981; opacity: 0.9;"></i> Inscrito
                            </div>
                        </div>

                        <div style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-md);">
                            <div style="font-family: 'Courier New', Courier, monospace; font-size: 1.1rem; font-weight: 700; color: var(--primary-blue); letter-spacing: 1px; padding: 6px 12px; background: rgba(12, 115, 183, 0.05); border-radius: var(--radius-sm); border: 1px dashed rgba(12, 115, 183, 0.2);">
                                @c.MembershipCode
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Aderir Turma Premium -->
<div id="joinClassModal" class="modal-overlay">
    <div class="modal-card glass-panel">
        <button type="button" class="modal-close-btn" id="closeJoinModalBtn">
            <i class="fas fa-times"></i>
        </button>
        
        <div style="text-align: left;">
            <div class="flex items-center gap-md mb-2">
                <div style="background-color: rgba(12, 115, 183, 0.1); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                    <i class="fas fa-sign-in-alt fa-lg"></i>
                </div>
                <div>
                    <h3 style="color: var(--primary-blue); font-size: 1.35rem; font-weight: 700; margin: 0;">Aderir à Turma</h3>
                    <p class="text-muted" style="font-size: 0.8rem; margin: 0;">Junta-te a uma turma de simulação.</p>
                </div>
            </div>
            
            <hr style="border: 0; border-top: 1px solid var(--border-color); margin: var(--spacing-md) 0;" />

            <form action="/Classes/Join" method="post" id="joinClassForm">
                <div class="form-group">
                    <label for="joinCodeInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-key"></i> Código de Adesão
                    </label>
                    <div class="input-icon-group" style="position: relative;">
                        <input type="text" name="membershipCode" id="joinCodeInput" class="form-control" placeholder="EX: K9X2WP" required autocomplete="off" maxlength="6" style="height: 44px; font-size: 1.15rem; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; padding-left: 2.75rem;" />
                        <i class="fas fa-hashtag" style="position: absolute; left: var(--spacing-md); top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1.1rem;"></i>
                    </div>
                    <span class="text-muted" style="font-size: 0.775rem; display: block; margin-top: 8px; line-height: 1.4;">
                        <i class="fas fa-info-circle"></i> O código único tem 6 dígitos. Pede ao teu professor.
                    </span>
                </div>

                <div class="flex gap-md" style="margin-top: var(--spacing-xl); justify-content: flex-end;">
                    <button type="button" class="btn btn-outline" id="cancelJoinModalBtn" style="padding: 0.55rem var(--spacing-md); font-size: 0.9rem;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="padding: 0.55rem var(--spacing-lg); font-size: 0.9rem; font-weight: 600; box-shadow: var(--shadow-sm);">
                        Entrar na Turma <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.openJoinModal = function(e) {
        if(e) e.preventDefault();
        var modal = document.getElementById('joinClassModal');
        modal.classList.add('active');
        
        var input = document.getElementById('joinCodeInput');
        if (input) {
            input.value = '';
            setTimeout(function() { input.focus(); }, 100);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const joinModal = document.getElementById("joinClassModal");
        const closeBtn = document.getElementById("closeJoinModalBtn");
        const cancelBtn = document.getElementById("cancelJoinModalBtn");

        function closeJoinModalFunc() {
            joinModal.classList.remove("active");
        }

        if (closeBtn) closeBtn.addEventListener("click", closeJoinModalFunc);
        if (cancelBtn) cancelBtn.addEventListener("click", closeJoinModalFunc);
        
        if (joinModal) {
            joinModal.addEventListener("click", function(e) {
                if (e.target === joinModal) {
                    closeJoinModalFunc();
                }
            });
        }
        
        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && joinModal && joinModal.classList.contains("active")) {
                closeJoinModalFunc();
            }
        });

        var joinInput = document.getElementById('joinCodeInput');
        if(joinInput) {
            joinInput.addEventListener('input', function(e) {
                var v = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                if(v.length > 6) v = v.slice(0,6);
                e.target.value = v;
            });
        }
    });
</script>

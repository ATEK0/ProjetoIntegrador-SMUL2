@model Portal.Models.ViewModels.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Os Meus Desafios";
}

<style>
    .badge-access {
        font-family: 'Courier New', Courier, monospace;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 1px;
        background: rgba(16, 185, 129, 0.08);
        color: #10b981;
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        border: 1px dashed rgba(16, 185, 129, 0.25);
        display: inline-block;
    }

    /* Modal styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        padding: var(--spacing-md);
    }

    .modal-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .modal-card {
        background: var(--surface-color);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: var(--shadow-lg);
        width: 100%;
        max-width: 500px;
        max-height: 90vh;
        overflow-y: auto;
        padding: var(--spacing-xl);
        position: relative;
        transform: scale(0.95) translateY(15px);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-overlay.active .modal-card {
        transform: scale(1) translateY(0);
    }

    .modal-close-btn {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        background: transparent;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        color: var(--text-muted);
        transition: var(--transition);
        width: 32px;
        height: 32px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        background-color: rgba(0, 0, 0, 0.05);
        color: var(--text-main);
    }

    .premium-label {
        font-weight: 600;
        color: var(--dark-grey);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-xs);
        font-size: 0.95rem;
    }

    .table-row-hover:hover {
        background-color: rgba(12, 115, 183, 0.02);
    }
</style>

<div class="container dashboard-page">
    <div class="dashboard-top">
        <partial name="_DashboardPageHeader" model='new DashboardPageHeaderViewModel { Title = "Os Meus Desafios", Subtitle = "Crie e faça a gestão de desafios de literacia financeira." }' />
        <button type="button" id="openChallengeModalBtn" class="btn btn-primary">
            <i class="fas fa-plus" style="margin-right: 8px;"></i> Criar Novo Desafio
        </button>
    </div>

    <div>
        @if (!Model.Challenges.Any())
        {
            <div class="card glass-panel text-center" style="grid-column: 1 / -1; padding: var(--spacing-xxl) 0;">
                <div style="background-color: rgba(16, 185, 129, 0.05); width: 80px; height: 80px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; color: #10b981; margin-bottom: var(--spacing-md);">
                    <i class="fas fa-trophy fa-3x"></i>
                </div>
                <h4 style="font-size: 1.2rem; margin-bottom: var(--spacing-xs); font-weight: 600;">Sem Desafios Configurados</h4>
                <p class="text-muted" style="max-width: 450px; margin: 0 auto; font-size: 0.875rem; line-height: 1.4;">Ainda não tem desafios de literacia financeira configurados.</p>
                <div style="margin-top: var(--spacing-md);">
                    <button type="button" class="btn btn-outline" onclick="document.getElementById('openChallengeModalBtn').click()" style="padding: 0.4rem 1rem; font-size: 0.85rem;">Criar Desafio</button>
                </div>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-lg);">
                @foreach (var challenge in Model.Challenges)
                {
                    <div class="card glass-panel" style="padding: var(--spacing-lg); display: flex; flex-direction: column; position: relative;">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm);">
                            <div style="display: flex; align-items: center; gap: var(--spacing-sm); overflow: hidden; width: 100%;">
                                <div style="overflow: hidden;">
                                    <h4 style="margin: 0; font-size: 1.1rem; color: var(--dark-grey); font-weight: 700; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@challenge.Title</h4>
                                </div>
                            </div>
                            <form action="/Challenges/Delete" method="post" onsubmit="return confirm('Tem a certeza que deseja eliminar este desafio?')">
                                <input type="hidden" name="id" value="@challenge.Id" />
                                <button type="submit" style="background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 4px; font-size: 0.9rem;" title="Eliminar Desafio">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                        
                        @if (!string.IsNullOrWhiteSpace(challenge.Description))
                        {
                            <p class="text-muted" style="font-size: 0.85rem; margin-bottom: var(--spacing-md); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@challenge.Description</p>
                        }

                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: var(--spacing-sm); color: var(--text-muted); font-size: 0.85rem;">
                            <i class="fas fa-graduation-cap" style="color: var(--text-muted); opacity: 0.7;"></i> @(challenge.Class != null ? challenge.Class.Name : "Geral (Sem turma)")
                        </div>

                        <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg); color: var(--text-muted); font-size: 0.85rem;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <i class="fas fa-reply" style="color: var(--text-muted); opacity: 0.7;"></i> @(challenge.Submissions != null ? challenge.Submissions.Count : 0) respostas
                            </div>
                        </div>

                        <div style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-md);">
                            <div style="font-family: 'Courier New', Courier, monospace; font-size: 1.1rem; font-weight: 700; color: #10b981; letter-spacing: 1px; padding: 6px 12px; background: rgba(16, 185, 129, 0.05); border-radius: var(--radius-sm); border: 1px dashed rgba(16, 185, 129, 0.2);">
                                @challenge.AccessLinkCode
                            </div>
                            <a href="/Challenges/Details/@challenge.Id" class="btn btn-outline" style="flex: 1; display: flex; justify-content: center; align-items: center; gap: 6px;">
                                <i class="fas fa-cog"></i> Gerir
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Criar Desafio -->
<div id="createChallengeModal" class="modal-overlay">
    <div class="modal-card">
        <button type="button" class="modal-close-btn" id="closeChallengeModalBtn">
            <i class="fas fa-times"></i>
        </button>
        
        <div style="text-align: left;">
            <div class="flex items-center gap-md mb-2">
                <div style="background-color: rgba(12, 115, 183, 0.1); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                    <i class="fas fa-trophy fa-lg"></i>
                </div>
                <div>
                    <h3 style="color: var(--primary-blue); font-size: 1.35rem; font-weight: 700; margin: 0;">Criar Novo Desafio</h3>
                    <p class="text-muted" style="font-size: 0.8rem; margin: 0;">Configure um desafio de literacia financeira para os seus alunos.</p>
                </div>
            </div>
            
            <hr style="border: 0; border-top: 1px solid var(--border-color); margin: var(--spacing-md) 0;" />

            <form action="/Challenges/Create" method="post" id="createChallengeForm">
                <div id="modalErrorContainer" style="display: none; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); padding: 10px; margin-bottom: 12px; border-radius: var(--radius-md); color: #991b1b; font-size: 0.85rem; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-circle"></i> <span id="modalErrorMessage"></span>
                </div>
                <div class="form-group">
                    <label for="challengeTitleInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-edit"></i> Título do Desafio
                    </label>
                    <input type="text" name="title" id="challengeTitleInput" class="form-control" placeholder="Ex: Simulação Orçamento Familiar" required autocomplete="off" maxlength="255" style="height: 44px; font-size: 0.95rem; width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border-color); padding: 0 12px;" />
                </div>

                <div class="form-group" style="margin-top: var(--spacing-md);">
                    <label for="challengeDescInput" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-align-left"></i> Descrição / Notas (Opcional)
                    </label>
                    <textarea name="description" id="challengeDescInput" class="form-control" placeholder="Descreva brevemente o objetivo do desafio..." style="height: 80px; font-size: 0.9rem; padding: 10px; resize: none; width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border-color);"></textarea>
                </div>

                <div class="form-group" style="margin-top: var(--spacing-md);">
                    <label for="challengeClassSelect" class="premium-label" style="font-size: 0.9rem; margin-bottom: 6px;">
                        <i class="fas fa-graduation-cap"></i> Associar a uma Turma (Opcional)
                    </label>
                    <select name="classId" id="challengeClassSelect" class="form-control">
                        <option value="">Nenhuma (Desafio Geral - Acesso por Código)</option>
                        @foreach (var cls in Model.Classes)
                        {
                            <option value="@cls.ClassId">@cls.ClassName</option>
                        }
                    </select>
                    <span class="text-muted" style="font-size: 0.775rem; display: block; margin-top: 8px; line-height: 1.4;">
                        <i class="fas fa-info-circle"></i> O desafio receberá um código alfanumérico único para os alunos entrarem diretamente.
                    </span>
                </div>
                <!-- Secção de Perguntas Dinâmicas na Criação -->
                <div style="margin-top: var(--spacing-md); border-top: 1px solid var(--border-color); padding-top: var(--spacing-md); margin-bottom: var(--spacing-md);">
                    <div class="flex justify-between items-center" style="margin-bottom: 12px;">
                        <label class="premium-label" style="font-size: 0.9rem; margin-bottom: 0;">
                            <i class="fas fa-question-circle"></i> Perguntas do Desafio
                        </label>
                        <button type="button" class="btn btn-outline" id="addQuestionBtn" style="font-size: 0.75rem; padding: 0.3rem 0.60rem;">
                            <i class="fas fa-plus"></i> Adicionar Pergunta
                        </button>
                    </div>

                    <div id="questionsContainer" style="display: flex; flex-direction: column; gap: var(--spacing-md); max-height: 250px; overflow-y: auto; padding-right: 4px;">
                        <!-- Perguntas serão adicionadas dinamicamente via JS -->
                    </div>
                </div>

                <div class="flex gap-md" style="margin-top: var(--spacing-xl); justify-content: flex-end;">
                    <button type="button" class="btn btn-outline" id="cancelChallengeModalBtn" style="padding: 0.55rem var(--spacing-md); font-size: 0.9rem;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="padding: 0.55rem var(--spacing-lg); font-size: 0.9rem; font-weight: 600; box-shadow: var(--shadow-sm);">
                        Criar Desafio <i class="fas fa-plus-circle" style="margin-left: 5px;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const challengeModal = document.getElementById("createChallengeModal");
        const openChallengeModalBtn = document.getElementById("openChallengeModalBtn");
        const closeChallengeModalBtn = document.getElementById("closeChallengeModalBtn");
        const cancelChallengeModalBtn = document.getElementById("cancelChallengeModalBtn");
        const challengeTitleInput = document.getElementById("challengeTitleInput");

        function openChallengeModal() {
            challengeModal.classList.add("active");
            if (challengeTitleInput) challengeTitleInput.focus();
        }

        function closeChallengeModal() {
            challengeModal.classList.remove("active");
            if (challengeTitleInput) challengeTitleInput.value = "";
            const challengeDescInput = document.getElementById("challengeDescInput");
            if (challengeDescInput) challengeDescInput.value = "";
            const challengeClassSelect = document.getElementById("challengeClassSelect");
            if (challengeClassSelect) challengeClassSelect.value = "";

            // Limpar perguntas adicionadas
            const container = document.getElementById("questionsContainer");
            if (container) container.innerHTML = "";

            // Ocultar erros
            const errContainer = document.getElementById("modalErrorContainer");
            if (errContainer) errContainer.style.display = "none";
        }

        if (openChallengeModalBtn) openChallengeModalBtn.addEventListener("click", openChallengeModal);
        if (closeChallengeModalBtn) closeChallengeModalBtn.addEventListener("click", closeChallengeModal);
        if (cancelChallengeModalBtn) cancelChallengeModalBtn.addEventListener("click", closeChallengeModal);
        
        challengeModal.addEventListener("click", function(e) {
            if (e.target === challengeModal) {
                closeChallengeModal();
            }
        });

        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && challengeModal.classList.contains("active")) {
                closeChallengeModal();
            }
        });

        // Lógica de adição de perguntas dinâmicas na criação
        const container = document.getElementById("questionsContainer");
        const addBtn = document.getElementById("addQuestionBtn");

        const form = document.getElementById("createChallengeForm");
        if (form && container) {
            form.addEventListener("submit", function(e) {
                const questions = container.querySelectorAll(".create-question-card");
                let hasValidQuestion = false;
                questions.forEach(card => {
                    const textInput = card.querySelector("input[name$='.QuestionText']");
                    if (textInput && textInput.value.trim() !== "") {
                        hasValidQuestion = true;
                    }
                });
                
                if (!hasValidQuestion) {
                    e.preventDefault();
                    const errContainer = document.getElementById("modalErrorContainer");
                    const errMsg = document.getElementById("modalErrorMessage");
                    if (errContainer && errMsg) {
                        errMsg.innerText = "O desafio deve conter pelo menos uma pergunta.";
                        errContainer.style.display = "flex";
                        challengeModal.querySelector(".modal-card").scrollTop = 0;
                    } else {
                        alert("O desafio deve conter pelo menos uma pergunta.");
                    }
                }
            });
        }

        if (addBtn && container) {
            addBtn.addEventListener("click", function() {
                const count = container.querySelectorAll(".create-question-card").length;
                
                const card = document.createElement("div");
                card.className = "create-question-card";
                card.style.cssText = "background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 12px; position: relative; text-align: left;";
                card.setAttribute("data-index", count);
                
                card.innerHTML = `
                    <button type="button" class="remove-question-btn" style="position: absolute; top: 8px; right: 8px; background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 4px; font-size: 0.9rem;" onclick="removeQuestionCard(this)" title="Remover Pergunta">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <div class="question-num-label" style="font-weight: 700; font-size: 0.8rem; color: var(--primary-blue); margin-bottom: 6px;">Pergunta #${count + 1}</div>
                    
                    <div class="form-group" style="margin-bottom: 8px;">
                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 2px; font-weight: 600;">Texto da Pergunta</label>
                        <input type="text" name="Questions[${count}].QuestionText" class="form-control" style="height: 34px; padding: 0 8px; font-size: 0.85rem;" required autocomplete="off" />
                    </div>

                    <div class="form-group" style="margin-bottom: 8px;">
                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 2px; font-weight: 600;">Tipo de Pergunta</label>
                        <select name="Questions[${count}].QuestionType" class="form-control question-type-select" style="height: 34px; padding: 0 8px; font-size: 0.85rem;" onchange="changeCreateQuestionType(this, ${count})" required>
                            <option value="Simple">Pergunta Simples (Texto Livre)</option>
                            <option value="MultipleChoice">Escolha Múltipla</option>
                            <option value="TrueFalse">Verd/Falso</option>
                            <option value="Scenario">Cenário</option>
                        </select>
                    </div>

                    <!-- MC Options (hidden by default) -->
                    <div class="create-mc-options-group" style="display: none; background: white; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 8px; margin-bottom: 8px;">
                        <div class="form-group" style="margin-bottom: 4px;">
                            <label class="form-label" style="font-size: 0.7rem; margin-bottom: 2px;">Opção A</label>
                            <input type="text" name="Questions[${count}].OptionA" id="optA_${count}" class="form-control mc-input" style="height: 30px; padding: 0 8px; font-size: 0.8rem;" />
                        </div>
                        <div class="form-group" style="margin-bottom: 4px;">
                            <label class="form-label" style="font-size: 0.7rem; margin-bottom: 2px;">Opção B</label>
                            <input type="text" name="Questions[${count}].OptionB" id="optB_${count}" class="form-control mc-input" style="height: 30px; padding: 0 8px; font-size: 0.8rem;" />
                        </div>
                        <div class="form-group" style="margin-bottom: 4px;">
                            <label class="form-label" style="font-size: 0.7rem; margin-bottom: 2px;">Opção C</label>
                            <input type="text" name="Questions[${count}].OptionC" id="optC_${count}" class="form-control mc-input" style="height: 30px; padding: 0 8px; font-size: 0.8rem;" />
                        </div>
                        <div class="form-group" style="margin-bottom: 4px;">
                            <label class="form-label" style="font-size: 0.7rem; margin-bottom: 2px;">Opção D</label>
                            <input type="text" name="Questions[${count}].OptionD" id="optD_${count}" class="form-control mc-input" style="height: 30px; padding: 0 8px; font-size: 0.8rem;" />
                        </div>
                    </div>

                    <!-- Correct Answer -->
                    <div class="create-correct-answer-group" style="display: none; margin-bottom: 4px;">
                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 2px; font-weight: 600;">Resposta Correta</label>
                        <select name="Questions[${count}].CorrectAnswer" class="form-control correct-ans-select" style="height: 34px; padding: 0 8px; font-size: 0.85rem;">
                            <option value="">Nenhuma</option>
                        </select>
                    </div>
                `;
                
                container.appendChild(card);
                container.scrollTop = container.scrollHeight;
            });
        }

        window.changeCreateQuestionType = function(select, index) {
            const card = select.closest(".create-question-card");
            const mcGroup = card.querySelector(".create-mc-options-group");
            const ansGroup = card.querySelector(".create-correct-answer-group");
            const ansSelect = card.querySelector(".correct-ans-select");
            
            const optA = card.querySelector(`#optA_${index}`);
            const optB = card.querySelector(`#optB_${index}`);
            const optC = card.querySelector(`#optC_${index}`);
            const optD = card.querySelector(`#optD_${index}`);

            const val = select.value;
            if (val === "MultipleChoice") {
                mcGroup.style.display = "block";
                ansGroup.style.display = "block";
                
                if (optA) optA.required = true;
                if (optB) optB.required = true;
                if (optC) optC.required = true;
                if (optD) optD.required = true;
                
                ansSelect.innerHTML = `
                    <option value="A">Opção A</option>
                    <option value="B">Opção B</option>
                    <option value="C">Opção C</option>
                    <option value="D">Opção D</option>
                `;
            } else if (val === "TrueFalse") {
                mcGroup.style.display = "none";
                ansGroup.style.display = "block";
                
                if (optA) { optA.required = false; optA.value = ""; }
                if (optB) { optB.required = false; optB.value = ""; }
                if (optC) { optC.required = false; optC.value = ""; }
                if (optD) { optD.required = false; optD.value = ""; }
                
                ansSelect.innerHTML = `
                    <option value="true">Verdadeiro</option>
                    <option value="false">Falso</option>
                `;
            } else {
                mcGroup.style.display = "none";
                ansGroup.style.display = "none";
                
                if (optA) { optA.required = false; optA.value = ""; }
                if (optB) { optB.required = false; optB.value = ""; }
                if (optC) { optC.required = false; optC.value = ""; }
                if (optD) { optD.required = false; optD.value = ""; }
                
                ansSelect.innerHTML = `<option value="">Nenhuma</option>`;
            }
        };

        window.removeQuestionCard = function(btn) {
            const card = btn.closest(".create-question-card");
            card.remove();
            reindexQuestions();
        };

        function reindexQuestions() {
            const container = document.getElementById("questionsContainer");
            if (!container) return;
            
            const cards = container.querySelectorAll(".create-question-card");
            cards.forEach((card, newIndex) => {
                card.setAttribute("data-index", newIndex);
                
                const label = card.querySelector(".question-num-label");
                if (label) label.innerText = `Pergunta #${newIndex + 1}`;
                
                card.querySelectorAll("[name]").forEach(input => {
                    const nameAttr = input.getAttribute("name");
                    const updatedName = nameAttr.replace(/Questions\[\d+\]/, `Questions[${newIndex}]`);
                    input.setAttribute("name", updatedName);
                });
                
                const selectType = card.querySelector(".question-type-select");
                if (selectType) {
                    selectType.setAttribute("onchange", `changeCreateQuestionType(this, ${newIndex})`);
                }
            });
        }
    });
</script>

@model Portal.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<style>
    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-xl);
        max-width: 900px;
    }

    @@media (max-width: 768px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    .profile-card {
        background-color: var(--surface-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: var(--spacing-xl);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .profile-card h3 {
        margin-bottom: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        font-size: 1.15rem;
        color: var(--dark-grey);
    }

    .profile-card h3 i {
        color: var(--primary-blue);
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-xl);
        padding-bottom: var(--spacing-lg);
        border-bottom: 1px solid var(--border-color);
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .profile-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .profile-meta .profile-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--dark-grey);
    }

    .profile-meta .profile-role {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--primary-blue);
        background-color: rgba(12, 115, 183, 0.08);
        padding: 3px 10px;
        border-radius: var(--radius-full);
        width: fit-content;
    }

    .profile-meta .profile-date {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .alert-box {
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-sm);
        margin-bottom: var(--spacing-md);
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .alert-success {
        color: #059669;
        background-color: rgba(5, 150, 105, 0.08);
        border: 1px solid rgba(5, 150, 105, 0.2);
    }

    .alert-error {
        color: #dc2626;
        background-color: rgba(220, 38, 38, 0.08);
        border: 1px solid rgba(220, 38, 38, 0.2);
    }

    .form-actions {
        margin-top: var(--spacing-lg);
    }

    .divider {
        height: 1px;
        background-color: var(--border-color);
        margin: var(--spacing-lg) 0;
    }
</style>

<!-- Cabeçalho do perfil -->
<div class="profile-header">
    <div class="profile-avatar">
        @(Model.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
    </div>
    <div class="profile-meta">
        <span class="profile-name">@Model.Name</span>
        <span class="profile-role"><i class="fas fa-shield-alt"></i> @Model.Role</span>
        <span class="profile-date"><i class="fas fa-calendar-alt"></i> Membro desde @Model.CreatedAt.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))</span>
    </div>
</div>

<div class="profile-grid">

    <!-- Card: Dados Pessoais -->
    <div class="profile-card">
        <h3><i class="fas fa-user-edit"></i> Dados Pessoais</h3>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert-box alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["ProfileSuccess"]</span>
            </div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert-box alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@TempData["ProfileError"]</span>
            </div>
        }

        <form asp-controller="Account" asp-action="Profile" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="Name">Nome</label>
                <input class="form-control" type="text" id="Name" name="Name" value="@Model.Name" placeholder="O seu nome completo" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="Email">E-mail</label>
                <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" placeholder="o.seu@email.com" required />
            </div>

            <div class="form-group">
                <label class="form-label">Função</label>
                <input class="form-control" value="@Model.Role" disabled style="background-color: var(--bg-color); cursor: not-allowed;" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-save" style="margin-right: 6px;"></i> Guardar Alterações
                </button>
            </div>
        </form>
    </div>

    <!-- Card: Alterar Password -->
    <div class="profile-card">
        <h3><i class="fas fa-lock"></i> Alterar Password</h3>

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="alert-box alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["PasswordSuccess"]</span>
            </div>
        }
        @if (TempData["PasswordError"] != null)
        {
            <div class="alert-box alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@TempData["PasswordError"]</span>
            </div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="CurrentPassword">Password Atual</label>
                <input class="form-control" type="password" id="CurrentPassword" name="CurrentPassword" placeholder="Insira a password atual" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="NewPassword">Nova Password</label>
                <input class="form-control" type="password" id="NewPassword" name="NewPassword" placeholder="Mínimo 6 caracteres" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="ConfirmNewPassword">Confirmar Nova Password</label>
                <input class="form-control" type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" placeholder="Repita a nova password" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-key" style="margin-right: 6px;"></i> Alterar Password
                </button>
            </div>
        </form>
    </div>

</div>

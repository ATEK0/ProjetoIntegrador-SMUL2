@model Portal.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<style>
    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-xl);
        max-width: 900px;
    }

    @@media (max-width: 768px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    .profile-card {
        background-color: var(--surface-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: var(--spacing-xl);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .profile-card h3 {
        margin-bottom: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        font-size: 1.15rem;
        color: var(--dark-grey);
    }

    .profile-card h3 i {
        color: var(--primary-blue);
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-xl);
        padding-bottom: var(--spacing-lg);
        border-bottom: 1px solid var(--border-color);
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .profile-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .profile-meta .profile-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--dark-grey);
    }

    .profile-meta .profile-role {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--primary-blue);
        background-color: rgba(12, 115, 183, 0.08);
        padding: 3px 10px;
        border-radius: var(--radius-full);
        width: fit-content;
    }

    .profile-meta .profile-date {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .form-actions {
        margin-top: var(--spacing-lg);
    }

    .divider {
        height: 1px;
        background-color: var(--border-color);
        margin: var(--spacing-lg) 0;
    }
</style>

<!-- Cabeçalho do perfil -->
<div class="profile-header">
    <div class="profile-avatar">
        @(Model.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
    </div>
    <div class="profile-meta">
        <span class="profile-name">@Model.Name</span>
        <span class="profile-role"><i class="fas fa-shield-alt"></i> @Model.Role</span>
        <span class="profile-date"><i class="fas fa-calendar-alt"></i> Membro desde @Model.CreatedAt.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))</span>
    </div>
</div>

<div class="profile-grid">

    <!-- Card: Dados Pessoais -->
    <div class="profile-card">
        <h3><i class="fas fa-user-edit"></i> Dados Pessoais</h3>

        <form action="/Account/Profile" method="post">
            @await Html.PartialAsync("_FormErrors")

            <div class="form-group">
                <label class="form-label" for="Name">Nome</label>
                <input class="form-control" type="text" id="Name" name="Name" value="@Model.Name" placeholder="O seu nome completo" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="Email">E-mail</label>
                <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" placeholder="o.seu@email.com" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="BirthDate">Data de Nascimento</label>
                <input class="form-control" type="date" id="BirthDate" name="BirthDate" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="form-group">
                <label class="form-label" for="GenderId">Género</label>
                <select class="form-control" id="GenderId" name="GenderId" data-ds-dropdown>
                    @{
                        var isM = Model.GenderId == 0 ? "selected" : null;
                        var isF = Model.GenderId == 1 ? "selected" : null;
                        var isO = Model.GenderId == 2 ? "selected" : null;
                    }
                    <option value="">Selecione...</option>
                    <option value="0" selected="@isM">Masculino</option>
                    <option value="1" selected="@isF">Feminino</option>
                    <option value="2" selected="@isO">Outro / Prefiro não dizer</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Função</label>
                <input class="form-control" value="@Model.Role" disabled style="background-color: var(--bg-color); cursor: not-allowed;" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-save" style="margin-right: 6px;"></i> Guardar Alterações
                </button>
            </div>
        </form>
    </div>

    <!-- Card: Alterar Password -->
    <div class="profile-card">
        <h3><i class="fas fa-lock"></i> Alterar Password</h3>

        <form action="/Account/ChangePassword" method="post">
            <div class="form-group">
                <label class="form-label" for="CurrentPassword">Password Atual</label>
                <input class="form-control" type="password" id="CurrentPassword" name="CurrentPassword" placeholder="Insira a password atual" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="NewPassword">Nova Password</label>
                <input class="form-control" type="password" id="NewPassword" name="NewPassword" placeholder="Mínimo 6 caracteres" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="ConfirmNewPassword">Confirmar Nova Password</label>
                <input class="form-control" type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" placeholder="Repita a nova password" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-key" style="margin-right: 6px;"></i> Alterar Password
                </button>
            </div>
        </form>
    </div>

</div>

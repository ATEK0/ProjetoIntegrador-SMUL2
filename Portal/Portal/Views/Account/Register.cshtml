@{
    ViewData["Title"] = "Registo";
    Layout = "_AuthLayout";
}

<form action="/Account/Register" method="post">
    @await Html.PartialAsync("_FormErrors")

    <div class="form-group">
        <label class="form-label" for="name">Nome Completo</label>
        <input class="form-control" type="text" id="name" name="name" placeholder="Insira o seu nome" required />
    </div>

    <div class="form-group">
        <label class="form-label" for="email">E-mail</label>
        <input class="form-control" type="email" id="email" name="email" placeholder="Insira o seu e-mail" required />
    </div>

    <div class="form-group">
        <label class="form-label" for="birthDate">Data de Nascimento</label>
        <input class="form-control" type="date" id="birthDate" name="birthDate" />
    </div>

    <div class="form-group">
        <label class="form-label" for="genderId">Género</label>
        <select class="form-control" id="genderId" name="genderId" data-ds-dropdown>
            <option value="">Selecione...</option>
            <option value="0">Masculino</option>
            <option value="1">Feminino</option>
            <option value="2">Outro / Prefiro não dizer</option>
        </select>
    </div>
    
    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" placeholder="Crie uma password" required />
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: var(--spacing-md);">Criar Conta</button>
    
    <div class="text-center text-muted" style="margin-top: var(--spacing-lg); font-size: 0.875rem;">
        Já tem conta? <a href="/Account/Login">Entre aqui</a>
    </div>
</form>

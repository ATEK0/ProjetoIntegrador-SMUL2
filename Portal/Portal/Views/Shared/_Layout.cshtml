<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEC Dinheiro em Casa</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/design-system.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <!-- Toastify -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    
    <!-- Choices.js -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    
    <style>
        .choices[data-type*="select-one"]::after {
            border-color: var(--text-muted) transparent transparent transparent;
        }
        .choices__inner {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            min-height: 44px;
            display: flex;
            align-items: center;
        }
        .choices__list--dropdown {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            z-index: 1000;
        }
        .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background-color: rgba(12, 115, 183, 0.05);
            color: var(--primary-blue);
        }
        .choices__list--dropdown .choices__item--selectable {
            font-size: 0.9rem;
        }
        .choices[data-type*="select-one"] .choices__inner {
            padding-bottom: 0px;
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="DEC Logo" />
            </div>
            
            <nav class="sidebar-nav">
                @if (User.IsInRole("Aluno") || User.IsInRole("Admin"))
                {
                    <a href="/Dashboard/Aluno" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Aluno" ? "active" : "")">
                        <i class="fas fa-home"></i> Dashboard Aluno
                    </a>
                }
                @if (User.IsInRole("Professor") || User.IsInRole("Admin"))
                {
                    <a href="/Dashboard/Professor" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Professor" ? "active" : "")">
                        <i class="fas fa-chalkboard-teacher"></i> Dashboard Professor
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <div style="margin-top: var(--spacing-lg); margin-bottom: var(--spacing-xs); padding-left: var(--spacing-md); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700;">
                        Administração
                    </div>
                    <a href="/Dashboard/Admin" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="fas fa-server"></i> Infraestrutura
                    </a>
                    <a href="/Dashboard/AdminClasses" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminClasses" ? "active" : "")">
                        <i class="fas fa-graduation-cap"></i> Turmas
                    </a>
                    <a href="/Dashboard/AdminChallenges" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminChallenges" ? "active" : "")">
                        <i class="fas fa-trophy"></i> Desafios
                    </a>
                    <a href="/Dashboard/AdminUsers" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminUsers" ? "active" : "")">
                        <i class="fas fa-users-cog"></i> Utilizadores
                    </a>
                }
            </nav>
            
            <div class="sidebar-footer">
                <a href="/Account/Logout" class="nav-item text-muted">
                    <i class="fas fa-sign-out-alt"></i> Sair
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="topbar">
                <div class="page-title">
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="user-profile">
                    <span class="text-muted">@User.Identity?.Name</span>
                    <div class="avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")</div>
                    <a href="/Account/Profile" class="btn btn-sm btn-outline-primary ms-3" style="font-size:0.85rem;">Perfil</a>
                </div>
            </header>

            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            
            // Initialize Choices.js
            const selectElements = document.querySelectorAll('select.form-control, select[name="newRoleName"], select[name="classId"]');
            selectElements.forEach(el => {
                new Choices(el, {
                    searchEnabled: false,
                    itemSelectText: '',
                    shouldSort: false,
                    position: 'bottom'
                });
            });
            @if (TempData["Success"] != null)
            {
                <text>
                Toastify({
                    text: "@TempData["Success"]",
                    duration: 3000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    style: {
                        background: "#10b981",
                        color: "#ffffff"
                    }
                }).showToast();
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                Toastify({
                    text: "@TempData["Error"]",
                    duration: 5000,
                    close: true,
                    gravity: "top",
                    position: "right",
                    style: {
                        background: "#ef4444",
                        color: "#ffffff"
                    }
                }).showToast();
                </text>
            }
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dinheiro em Casa — plataforma educativa de literacia financeira com simulações e desafios para alunos e professores." />
    <title>@ViewData["Title"] - DEC Dinheiro em Casa</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/design-system.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/landing.css" />
</head>
<body class="landing-page">
    <header class="landing-header" id="topo">
        <div class="landing-container landing-header__inner">
            <a href="/" class="landing-brand">
                <img src="~/images/logo.png" alt="DEC Logo" />
                <span>Dinheiro em Casa</span>
            </a>

            <input type="checkbox" id="nav-toggle" class="landing-nav-toggle" aria-hidden="true" />
            <label for="nav-toggle" class="landing-nav-btn" aria-label="Abrir menu">
                <i class="fas fa-bars"></i>
            </label>

            <nav class="landing-nav">
                <a href="#funcionalidades">Funcionalidades</a>
                <a href="#como-funciona">Como funciona</a>
                <a href="#publico">Para quem</a>
                <a href="/Account/Login" class="btn btn-outline btn-sm">Entrar</a>
                <a href="/Account/Register" class="btn btn-primary btn-sm">Criar conta</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="landing-footer">
        <div class="landing-container landing-footer__grid">
            <div>
                <a href="/" class="landing-brand landing-brand--footer">
                    <img src="~/images/logo.png" alt="DEC Logo" />
                    <span>Dinheiro em Casa</span>
                </a>
                <p class="text-muted landing-footer__tagline">
                    Plataforma digital de literacia financeira — Projeto Integrador SMUL2, ISTEC.
                </p>
            </div>
            <div>
                <h4>Plataforma</h4>
                <ul>
                    <li><a href="#funcionalidades">Funcionalidades</a></li>
                    <li><a href="#como-funciona">Como funciona</a></li>
                    <li><a href="/Account/Login">Entrar</a></li>
                    <li><a href="/Account/Register">Registar</a></li>
                </ul>
            </div>
            <div>
                <h4>Contacto</h4>
                <ul>
                    <li><a href="mailto:suporte@dinheiroemcasa.pt">suporte@dinheiroemcasa.pt</a></li>
                </ul>
            </div>
        </div>
        <div class="landing-container landing-footer__bottom">
            <p>&copy; @DateTime.Now.Year Dinheiro em Casa. Todos os direitos reservados.</p>
            <a href="#topo" class="landing-back-top"><i class="fas fa-arrow-up"></i> Topo</a>
        </div>
    </footer>
</body>
</html>

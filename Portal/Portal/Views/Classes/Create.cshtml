@model Portal.Models.SchoolClass

@{
    ViewData["Title"] = "Criar Nova Turma ou Desafio";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 shadow p-4 rounded bg-white">
            <h2 class="text-primary mb-3">Criar Turma / Desafio</h2>
            <p class="text-muted">Introduza o nome da turma para gerar automaticamente o código de adesão para os alunos.</p>
            <hr />

            <form asp-action="Create">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group mb-4">
                    <label asp-for="Name" class="control-label fw-bold mb-2">Nome da Turma / Desafio</label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Ex: 11º B - Economia A" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group d-flex justify-content-between">
                    <button type="submit" class="btn btn-success btn-lg px-4">Criar e Gerar Código</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
